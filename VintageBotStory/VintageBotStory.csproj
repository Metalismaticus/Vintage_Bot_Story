<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ОБЪЯСНЕНИЯ НАСТРОЕК В ОКНЕ УПРАВЛЕНИЯ берутся из док-строк роли: панель
         читает VintageBotStory.xml рядом с собранной сборкой. Без этой строки файла не
         будет, и панель честно скажет, что объяснений нет, — но и не покажет их,
         а настройка «ПробиватьсяЧерез» без подписи не значит ничего.
         NoWarn обязателен: без него сборка прибавляет ~80 предупреждений
         CS1591/CS1573 на каждое неописанное публичное имя -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Где стоит игра, считает Directory.Build.props в корне -->
    <NeedsGame>true</NeedsGame>
  </PropertyGroup>

  <ItemGroup>
    <!-- Готовые боты: бот ищет их в папке presets рядом с собой -->
    <None Include="../presets/*.json" Link="presets/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../VsBotKit/VsBotKit.csproj" />
    <!-- Ядро физики — игровое, поэтому её типы видны и в примере бота -->
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
