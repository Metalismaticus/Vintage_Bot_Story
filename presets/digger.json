{
  // Готовый бот-копатель для испытаний.
  //
  // Запуск:  VintageBotStory --preset digger
  // В игре:  !добудь медь 20   !копай   !разведай   !склад тут   !запасы
  //          !дорога 300 110 -250 340 110 -250 3     !собери
  //
  // В пресете лежит только «кем быть». Адрес сервера, имя, токен и пароль
  // сюда не пишутся никогда: этим файлом можно делиться.
  "id": "digger",
  "title": "Копатель",
  "about": "Карьеры, штольни, руда, дороги. Скажите «!добудь медь 20» — уйдёт и принесёт",
  "role": "survivor",
  "needs": [
    "кирка по зубам той породе, что копаем",
    "сундук рядом под склад (или скажите в чате «!склад тут»)",
    "для дороги — покрытие в сумках; перепад берётся ступенькой «блок + полублок на нём»",
    "для «ОтмечатьДом» — временная шестерёнка (gear-temporal) в сумке или в сундуке склада: точка возрождения ставится ТОЛЬКО ею, и она при этом тратится. В мире шестерёнка не растёт и не крафтится — её кладёт хозяин",
    "для сна — КРОВАТЬ, поставленная у дома. Одной точки «Дом» мало: лечь можно только в кровать, а дом — это куда за ней идти. Ещё нужны ночь, усталость выше 8 и отсутствие временной бури; чего не хватает, бот называет в журнале сам"
  ],
  "diag": true,
  "settings": {
    "СмелостьВПути": 1,
    "РазмерКарьера": 7,
    "ГлубинаКарьера": 3,

    // ЦЕЛЬНЫЙ КАМЕНЬ ВМЕСТО ЩЕБЁНКИ. Правило не наше, а игры, и игра пишет его
    // в справочнике самого блока: «Full block can be obtained by breaking all
    // adjacent blocks». Обычный удар по камню даёт две-три штуки stone-… ,
    // а ЦЕЛЫЙ блок падает только с того камня, у которого сняты ВСЕ ШЕСТЬ
    // соседей (поведение BreakIfFloating). Инструмент тут ни при чём — решает
    // порядок ударов.
    //
    // Включено — «добудь rock-granite 20» обкапывает камень со всех сторон и
    // приносит целые блоки; выключено — то же поручение честно откажется и
    // назовёт причину, а не будет бить гранит до конца срока, принося щебёнку
    // с другим именем (так оно и было: наряд говорил «больше рядом нет», стоя
    // на граните). Цена включённого — до шести соседей в щебёнку за каждый
    // целый блок и лишние подходы: где нужен просто камень, выключайте
    //
    // ИМЯ СМЕНИЛОСЬ 28.08 («ДобыватьЦельныйКамень» → «ОбкапыватьРадиЦельногоБлока»),
    // и это не косметика: правило внутри не спрашивает материал вовсе — оно
    // спрашивает признак блока (BreakIfFloating) и «нет ли просимого среди
    // обычных выпадений».
    //
    // КОГДА ОНО СРАБАТЫВАЕТ: вы назвали код блока ДОСЛОВНО. Кроме породы под
    // это в ванили 1.22.7 попадают гнилое бревно rottenlog-* (с удара падает
    // только личинка), термитник termitemound-* (только термит) и ВСЕ НЕСОРТНЫЕ
    // РУДЫ (ore-ungraded.json: flint, lignite, bituminouscoal, anthracite,
    // quartz, cinnabar, borax, sylvite и прочие). У несортной руды выпадение
    // КОРОЧЕ кода блока: с ore-bituminouscoal-shale падает ore-bituminouscoal,
    // без породы в имени, — значит просьба по полному коду блока тоже зовёт
    // обкапывание. Здесь стоял один «ore-flint-*», и по объёму это была
    // неправда: кремень не исключение, а первый в списке из полутора десятков.
    // То есть «!принеси rottenlog-east 1» тоже заставит бота обкопать соседей
    // вокруг бревна.
    //
    // СОРТНЫЕ руды (ore-graded.json) сюда НЕ попадают: их выпадение повторяет
    // код блока целиком, просимое падает с одного удара.
    //
    // МЕТЕОРИТА В ЭТОМ СПИСКЕ БОЛЬШЕ НЕТ: он тут стоял ошибочно. С meteorite-iron
    // падает предмет stone-meteorite-iron, то есть просимое СРЕДИ выпадений
    // есть, и обкапывать его незачем (assets/survival/blocktypes/stone/meteorite.json).
    //
    // И ВАЖНОЕ ПРО ПОХОЖИЕ ИМЕНА. «Дословно» — это равенство кода, а не
    // подстрока: на «rock-granite» бот НЕ примет crackedrock-granite, хотя тот
    // и содержит эти буквы, и тоже падает целым. Пока мерка была подстрочной,
    // бот обкапывал треснувшую породу и докладывал об успехе, принеся не то.
    //
    // Старое имя по-прежнему понимается — свои файлы править не обязательно.
    "ОбкапыватьРадиЦельногоБлока": true,

    // ЦЕНА ОБКАПЫВАНИЯ: сколько заходов на одну грань. Всего кругов будет
    // шесть (граней у куба) на это число, и КАЖДЫЙ КРУГ — ещё один снесённый
    // чужой блок вокруг цели: при тройке одно «!добудь» вправе снести до
    // восемнадцати соседей ради одного целого камня.
    //
    // Три — это грань, её ОСЫПАНИЕ и ПРОКОП к замурованному соседу. Осыпание
    // не выдумано: у гравия и песка висит UnstableFalling с
    // fallSidewaysChance 0.75 — падая, они с вероятностью три четверти
    // сваливаются в соседнюю клетку и засыпают освобождённую грань.
    //
    // Дорожите миром вокруг — ставьте 1: снесут не больше шести, но на
    // осыпающейся породе целого блока часто не выйдет вовсе, и бот назовёт
    // клетку, грань и число отработанных кругов, а не смолчит. Ниже единицы
    // не опускается: нулём заходов не освободить ни одной грани.
    "ЗаходовНаГраньОбкапывая": 3,

    // КОПАТЬ ШАХМАТКОЙ — «ЧЕРЕЗ ОДНУ», РАДИ ЦЕЛЫХ БЛОКОВ ВМЕСТО ЩЕБНЯ.
    //
    // Это ПОРЯДОК, а не выбор: ни одна клетка из работы не выпадает и ни один
    // лишний блок не ломается. Сперва снимаются «жертвы» — клетки одной
    // чётности и каждый второй поперечный слой, — а у остальных к их очереди
    // не остаётся НИ ОДНОЙ твёрдой грани. Игра при шести свободных гранях
    // отдаёт РОВНО ОДИН ЦЕЛЫЙ БЛОК вместо двух-трёх кусков щебня
    // (поведение BreakIfFloating, assets/survival/blocktypes/stone/rock.json).
    //
    // Ручка стоит У САМОГО УДАРА, поэтому её видит каждый, кто снимает породу,
    // а не каждая работа по отдельности. У карьера есть ещё и своя
    // «РовнаяЯмаЦеликом», но она про ВИД ямы, а эта про порядок: выключите
    // любую из двух — шахматки в яме не будет.
    //
    // Цена — ВРЕМЯ, а не блоки: ударов столько же, но по выработке приходится
    // пройти дважды (сперва за жертвами, потом за целыми). Нужна просто яма —
    // выключайте.
    //
    // КОГО ЭТО КАСАЕТСЯ — СПИСКОМ: ЯМА КАРЬЕРА И ОКАПЫВАНИЕ ЖИЛЫ. Обе снимают
    // ОБЪЁМ, то есть тело с толщиной по всем трём осям, а целый блок бывает
    // только там: у клетки должны освободиться ВСЕ ШЕСТЬ граней, значит каждый
    // сосед обязан либо быть воздухом, либо уйти вместе с ней.
    //
    // ДОРОГА, ШТОЛЬНЯ И УКРЫТИЕ ЦЕЛЫХ БЛОКОВ НЕ ДАЮТ НИ ОДНОГО, и это не
    // недоработка. Они снимают породу СРЕЗАМИ — ряд дороги, шаг хода, одна-две
    // клетки стены, — а у среза сосед ВПЕРЁД в заход не входит и стоит
    // нетронутой породой; одной твёрдой грани хватает, чтобы блок рассыпался
    // щебнем. Числа: ход 3×3×8 = 72 клетки объёмом даёт 3 целых, он же
    // срезами, как его копают живьём, — НОЛЬ.
    //
    // Здесь стояло «хотите целые блоки с дороги или хода — ставьте им ширину
    // от 3». Это была неправда: поставивший тройку вынимал втрое больше
    // породы и не получал ни одного целого блока, а у штольни ширины нет
    // вовсе — только «ВысотаШтольни».
    "ШахматкойРадиЦельныхБлоков": true,

    // ВИД ЯМЫ ПРОТИВ ВЫХОДА ЦЕЛЫХ БЛОКОВ. Выключено — карьер идёт ШАХМАТКОЙ, и
    // тогда около четверти объёма падает ЦЕЛЫМИ блоками (правило игры
    // BreakIfFloating), которые не надо ни обжигать, ни складывать по четыре.
    // Плата — вид: пока яма не добита, в ней стоит решётка недобранных клеток,
    // и заказчик однажды счёл по снимку яму недокопанной. Включают там, где яму
    // показывают людям
    "РовнаяЯмаЦеликом": false,

    "ГлубинаРазведки": 24,
    "ДлинаШтрека": 16,
    "ЧислоШтреков": 3,
    // ФАКЕЛЫ ВРЕМЕННО ВЫКЛЮЧЕНЫ (просьба заказчика 15.08: «убери тогда временно
    // факелы в следующем прогоне»). Живой случай: перед КАЖДЫМ нарядом бот
    // заводил одну и ту же безнадёжную цепочку — «не хватает torch ×16» →
    // «добыть hay-normal-ud ×4» → «hay-normal-ud рядом больше не нахожу» → и так
    // по кругу, впустую, пока не начнётся само дело. Ноль — не «факелы плохи», а
    // «не тратить на них время, пока не починена сама цепочка запасов»
    "ДержатьФакелов": 0,

    // ИНСТРУМЕНТЫ — ВСЕ, А НЕ ОДНА КИРКА. Прямая просьба заказчика:
    // «инструменты нужно крафтить все (я про настройки, а не только кирку)».
    // Живой случай, который это стоило: «ломаю soil-low-none: 1,8 с
    // (blade-blackguard-iron)» — бот копал землю МЕЧОМ, потому что лопаты не
    // было ни в руке, ни в требованиях. Лопатой тот же блок берётся за 0,4 с.
    // Список человеческий; чего нет — бот сделает по рецепту. Пусто — не
    // требовать ни одного
    "ДержатьИнструменты": "кирка, лопата, топор, нож",

    // ЛЕСТНИЦЫ ПРИ СЕБЕ. Прямой заказ: «к запасам нужно добавить лестницы
    // вертикальные, бот должен носить их с собой и/или крафтить». Живой журнал
    // 16.08, дважды за ночь (01:33 и 09:20): «наверх на 2 бл: … а есть блоков 0
    // и лестниц 0 … и ступеней не вырубить».
    //
    // ШЕСТЬДЕСЯТ ЧЕТЫРЕ — прямой заказ 20.08: «поправь в запасах количество
    // лестниц — нужно с собой носить 64». Стояло четыре: лестницы вешают ЧЕРЕЗ
    // ОДНУ, значит четыре — это восемь блоков подъёма, ровно обе ямы той ночи.
    // На смену в забое этого мало — повешенную лестницу за собой не снимают, и
    // запас кончался после двух подъёмов. 64 — полная стопка в игре
    // (MaxStackSize у лестницы не переопределён, а заводской ровно 64), то есть
    // «носить стопку», а не выдуманное число. Ванильный рецепт даёт три
    // лестницы из восьми палок — палки бот собирает по дороге сам
    "ДержатьЛестниц": 64,

    // ЗАПАС ПО РАСХОДУ — «ЧЕМ ПОЛЬЗУЮСЬ, ТО И ДЕРЖУ». Заказ 26.08 дословно:
    // «также больше бы логики, чтобы бот сам понимал чего ему не достает и
    // крафтил, например стрелы».
    //
    // Соседние две строки («ДержатьИнструменты», «ДержатьЛестниц») — запас
    // НЕПОДВИЖНЫЙ: сказано 64 — значит 64, сколько бы бот ни тратил. Для кирки
    // так и надо, для расходника это неправда в обе стороны сразу: бот, ни разу
    // не стрелявший, таскал бы стопку стрел «на всякий случай», а бот,
    // отстреливающий по сорок за вылазку, вставал бы посреди охоты с
    // шестнадцатью.
    //
    // ЧИТАЕТСЯ «расходник к тому, чем его тратят». «arrow к bow» значит: пока
    // лука в сумке нет — стрелы не нужны ВОВСЕ (требование снимается, бот за
    // ними не ходит и не делает); появился лук — держим по расходу. Без «к»
    // (например просто «torch») поводом остаётся один лишь расход.
    //
    // Род, а не полный код: «arrow» — это все четырнадцать материалов стрел
    // разом, а «arrowhead» (наконечник) под него НЕ подходит.
    //
    // Пусто — правило выключено. Факелы сюда вписывать НЕ НАДО, пока стоит
    // «ДержатьФакелов»: на одно требование заговорили бы два голоса, и бот
    // скажет об этом вслух, а крутить не станет
    "ЗапасПоРасходу": "arrow к bow",

    // НА СКОЛЬКО МИНУТ РАСХОДА ДЕРЖАТЬ. Читается буквально: «сколько трачу за
    // полчаса — столько и ношу». Больше — не лучше: несколько часов означают
    // «носи всё, что потратил за смену», то есть хомяка, а на метания за
    // припасами заказчик уже жаловался. Верхний край всё равно держит полная
    // стопка по реестру
    "ЗапасНаМинутРасхода": 30,

    // СКОЛЬКО ДЕРЖАТЬ, ПОКА НЕ ТРАТИЛ НИ РАЗУ. Без этого числа правило не
    // заводится вовсе: чтобы начать тратить стрелы, их надо сперва иметь.
    // Оно же остаётся нижним краем и потом — истратил две за полчаса, это не
    // повод ходить с двумя. Ноль — законный выбор «только по расходу»
    "ЗапасНаПервыйРаз": 16,

    // НУЖЕН ЛИ БОТУ ЛУК — считать ли его НЕХВАТКОЙ и добывать наравне с киркой.
    //
    // ЗАЧЕМ ГАЛОЧКА ВООБЩЕ ЕСТЬ. Ручка «ЗапасПоРасходу» умеет «arrow к bow» —
    // «стрелы, пока при мне лук», — а самого ЛУКА не просил никто и
    // никогда. Выходило кольцо, из которого бот не мог выйти сам: лука нет →
    // стрелы не нужны → стрел нет → и лук ни к чему. Весь дальний бой держался
    // на том, что лук боту КТО-ТО ПОЛОЖИТ. Галочка убирает «кто-то».
    //
    // ЧИСЕЛ РЕЦЕПТА ЗДЕСЬ НЕТ И БЫТЬ НЕ ДОЛЖНО: что из чего, присылает сервер
    // вместе с реестром рецептов. В ванильной игре 1.22.7 выходит «простой
    // лук» (bow-simple) — 3 палки и 3 бечёвки, бечёвка это 4 льняных волокна.
    // Сверено по самому файлу игры (grid/tool/bow.json, узор «_ST S_T _ST» с
    // «T: flaxtwine»; grid/twine.json, узор «FF FF»), а НЕ по ответу бота:
    // прежде здесь стояла ссылка на живую строку «Для bow-crude не хватает:
    // stick 0/3, rope 0/3» — а это ДРУГОЙ рецепт, запертый чертой «bowyer»,
    // и верёвки у простого лука нет вовсе. Ту строку выдавала сломанная
    // команда «!рецепт» (чинена 27.08), и волна процитировала её как факт.
    //
    // ПОЧЕМУ НЕ СЛОВОМ В «ДержатьИнструменты»: в русском языке ИГРЫ «Лук» —
    // это ОВОЩ (item-vegetable-onion), а оружие зовётся «Простой лук». Бот
    // честно ответил бы «это не инструмент», и виноватым выглядел бы он.
    // Копателю лук нужен: соседние ручки «СтрелятьИзЛука» и
    // «ВстречатьЛукомИздалека» стоят включёнными, а стрелять было НЕ ИЗ ЧЕГО.
    "НуженЛук": true,

    // МЫТЬ ЛИ ЛОТКОМ, когда нужного нет ни в сумке, ни в мире.
    //
    // ЧТО ЭТО ОТКРЫВАЕТ. Две волны подряд бот не мог сделать лук, и обе
    // объяснили это одинаково: «flaxfibers в зимнем мире нет». Неправда, и
    // здесь стояла ВТОРАЯ неправда: «волокна падают ровно с одного блока».
    // Проверено по ассетам установленной игры 1.22.7 — источников несколько:
    //   • спелый лён crop-flax-9 (blocktypes/plant/crop/flax.json) — зимой нет;
    //   • ГЛИНЯНЫЕ СХРОНЫ, и это тоже БЛОК: blocktypes/clay/lootvessel.json,
    //     lootvessel-forage 0,5 × 1..12, -farming 0,75 × 2..10,
    //     -arcticsupplies 0,5 × 1..12 — один схрон закрывает тетиву целиком;
    //   • дрифтеры, шиверы и боуторны (entities/lore/*.json, avg 0,2 и 0,4);
    //   • лоток из КОСТЯНОЙ ЗЕМЛИ (blocktypes/wood/pan.json, panningDrops,
    //     ключ «@(bonysoil|bonysoil-.*)»), и время года тут ни при чём.
    //
    // ПОЧЕМУ ВСЁ-ТАКИ ЛОТОК, А НЕ СХРОН. Схрон надо НАЙТИ: в живом мире
    // заказчика в 96 блоках нашлись только «-tool», «-ore» и «-seed», волокон
    // не дающие, а ближайший вообще — в 75 блоках. Костяная же земля лежала в
    // четырнадцати блоках от точки входа всё это время.
    //
    // ЧЕСТНАЯ ЦЕНА. За промывку выпадает НЕ БОЛЬШЕ ОДНОЙ вещи, и волокно
    // достаётся примерно раз из девяти (0,111 — считано по таблице ассета,
    // а не по числу «0,15» из неё: перебор идёт до первого попадания, и
    // кость с шансом 0,3 часть бросков забирает). На три мотка тетивы —
    // около 110 промывок: ~13 блоков костяной земли и ~7 минут одного лишь
    // держания кнопки. Ноги при этом обязаны стоять в воде: этого требует
    // сама игра (ingameerror-panning-notinwater).
    //
    // Копателю лоток нужен ровно затем же, зачем кирка: закрыть нехватку тем, что
    // есть под ногами. Костяная земля попадается в тех же ямах, что и руда.
    "МытьЛоткомКогдаИначеНегде": true,

    // Сколько блоков вокруг искать воду И промываемую землю: мыть можно
    // только там, где они рядом друг с другом — горсть берётся рукой с
    // берега, а стоять надо в воде
    "ЛотокИщетВодуДо": 24,

    // Сколько промывок за один заход. Каждая — 4 секунды неподвижности и
    // 4 единицы сытости (ConsumeSaturation(4f) в самой игре). Заход кончился —
    // бот огляделся; при нужде придёт снова
    "ПромывокЗаЗаход": 25,

    // СКОЛЬКО ДЕРЖАТЬ СВЕРХ ЗАПАСА, ПРОЦЕНТОВ, — А ОСТАЛЬНОЕ НА СКЛАД.
    //
    // До 26.08 запас был только НИЖНИМ краем: бот знал, сколько ему надо, и не
    // знал, сколько ему много. Подобранные с земли стрелы и лишние лестницы
    // оседали в сумке навсегда, а разгрузка отвечала «в сумке только своё —
    // нести нечего»: на вопрос «твоё?» и одна стрела, и четыреста давали одно
    // и то же «да». Теперь всё, что выше запаса и этой прибавки, уезжает в
    // сундук, и бот говорит числом. При запасе 64 и прибавке 25 % он держит 80, и
    // на двух сотнях стрел выходит: «отнёс на склад лишние 120 (arrow-flint),
    // таких при себе осталось 80» и следом «по запасу „arrow“ держу 80, при
    // мне сейчас 80».
    //
    // Прибавка нужна затем, что бот без стрел посреди леса хуже бота с лишними
    // двадцатью; она же служит порогом рейса — пока излишек меньше прибавки,
    // бот с места не сходит. Проценты, а не штуки: одна ручка обслуживает и
    // стрелы (64 -> 80), и кирку (1 -> 1, обычное округление). Ноль законен:
    // «держу ровно по запасу». Кирки, факела и еды без запаса это не касается:
    // они остаются по маске «ОставлятьПриСебе», а счёта у маски нет
    "ДержатьСверхЗапасаПроцентов": 25,

    // ГДЕ ИСКАТЬ МАТЕРИАЛ, блоков вокруг себя. До 22.08 это число было внутри
    // механизма, и человек его не видел; теперь по нему бот решает, ОБЕЩАТЬ ли
    // поход, и говорит вслух «в этой местности этого не найти: принесите».
    //
    // Живой случай, который это стоил: «чтобы получить Axe, надо: добыть
    // stone-chert ×2 …» → «stone-chert рядом больше не нахожу», и так прогон за
    // прогоном которую неделю — при том что вокруг лежал перидотит, а топор из
    // него ровно такой же. Разбор брал породу по длине кода и спрашивал только
    // реестр («бывает ли такое в игре»), а не мир («есть ли оно здесь»).
    //
    // 48 — прежнее заводское значение поручений, оно же цена вопроса: обзор
    // такой округи стоит миллисекунды, вчетверо больший — в шестнадцать раз
    // дороже. Больше ставят в скудной местности, меньше — тому, кому нельзя
    // отходить от места
    "ИскатьМатериалВРадиусе": 48,

    "СобиратьЕду": true,
    "РадиусСбораЕды": 32,

    // ДИКИЕ ПОСЕВЫ. Генератор мира сеет полбу, рожь, лён, морковь и лук
    // пятнами по 5–16 штук — для бота, ушедшего в забой на полдня, это
    // ближайшая еда. Чужие грядки при этом не трогаем: посаженное растёт на
    // вспаханной земле, и отличает их мир, а не наша совесть
    "СобиратьПосевы": true,
    "ТрогатьЧужиеГрядки": false,

    "ЗабиратьВещи": true,
    "ЗаВещамиНеДальше": 250,

    // ПРОПИТАНИЕ: ЧЕМ ЗАКРЫВАТЬ ГОЛОД, КОГДА ЕДЫ В СУМКАХ НЕТ.
    // Способы пробуются по порядку: кладовые -> готовка -> дикая еда -> охота.
    // До 26.08 цепочка обрывалась на «дикой еды в 32 бл не видно», и бот ждал,
    // хотя убивать, разделывать и готовить умел
    // Копатель уходит от дома надолго, и кладовая у него за спиной не всегда:
    // охота ему нужнее всех. Костёр он и так разводит ради тепла
    "ЕдаИзКладовых": true,
    "ГотовитьЕду": true,
    "СколькоЖдатьГотовки": 45,
    "Охотиться": true,
    "ОхотитьсяНеДальше": 32,
    "СколькоДержатьТелоЗаОхоту": 25,

    // ДОБЫЧА С УБИТЫХ. Заказ дословно: «Нужно подбирать выпавшие вещи из мобов
    // и разделывать их (отдельная настройка)». Настройки две, потому что в
    // игре это два разных механизма: с саранчи и звонаря вещи падают НА ЗЕМЛЮ
    // в миг смерти и подбираются ногами, а у дрифтера, шивера, оленя и волка
    // список выпадающего ПУСТ — вся добыча (шестерёнка, гниль, шкура) лежит
    // внутри туши и достаётся ножом, в приседе. Двенадцать блоков — мерка
    // забоя: за шкурой в полсотни блоков копатель ходить не станет
    "ПодбиратьДобычуСУбитых": true,
    "РазделыватьТуши": true,
    "ЗаДобычейСУбитыхНеДальше": 12,

    // РАЗДЕЛКА ПЕРЕБИВАЕТ РАБОТУ — и копателю это нужнее всех. Жалоба
    // заказчика 28.08 дословно: «трупы остаются с вещами и не исчезают».
    // Так и было: карьер держал тело как приказ, разделка просила его
    // обычным делом роли и ждала — а туше дрифтера отведено три игровых
    // часа (deaddecay, hoursToDecay: 3), при обычной скорости времени это
    // шесть реальных минут. Не успел — пропало всё, что в туше лежало.
    // Камень никуда не денется, а туша сгниёт; спасение (бой, побег, еда,
    // лечение) стоит выше разделки при любом положении этой галочки
    "РазделкаПеребиваетРаботу": true,

    // ЗА СВОЕЙ ВЫЛОМАННОЙ ДОБЫЧЕЙ НЕ ДАЛЬШЕ, блоков. 0 — предела нет.
    //
    // Предела здесь не было вовсе, и вот чего это стоило (журнал 17.08,
    // трижды подряд за три минуты):
    //   23:54:53 я дома
    //   23:54:54 [движение] дорога: 4 точек до (512042, 110, 512237)
    //   23:54:59 [движение] точки кончились, а по высоте не дошёл
    // Секунда между «я дома» и уходом за двадцать шесть блоков — и ни слова о
    // том, зачем. Уводили бота ПОМЕТКИ: дорога наломала клеток на дальнем
    // своём конце, каждая легла пометкой, разбираются они по одной, а дорога
    // К пометке не мерилась ничем (мерился только осмотр ВОКРУГ неё).
    //
    // Шестнадцать — вдвое больше осмотра: своё, выломанное только что, лежит
    // рядом, а за дальним придёт наряд или разгрузка. Пометка при отказе не
    // забывается: бот подберёт выпавшее, когда работа приведёт его туда снова
    "ЗаСвоейДобычейНеДальше": 16,

    // ЧТО ВЫБРОСИТЬ, КОГДА МЕСТА НЕТ НИГДЕ. Последняя ступень «некуда взять
    // хлеб»: сперва бот выносит лишнее в сумку, потом меняется слотами, и
    // только потом расстаётся с самой дешёвой стопкой земли. Ради еды — даже
    // при выключенном общем разрешении: иначе бот умирает с хлебом в кармане.
    // «НеВыбрасывать» нужно там, где бросовое по мерке игры на деле ценно:
    // глина в реестре — блок с материалом Soil, то есть земля
    "ВыбрасыватьЛишнее": true,
    "ВыбрасыватьРадиЕды": true,
    "НеВыбрасывать": "",

    // ВЕСА ВАЖНОСТИ. Пусто — заводские: возрождение 100, спасение 95,
    // опасность 90, лечение 85, еда 80, работа 50, без дела 0. Крутится
    // строкой («еда 95; бой 70») или стрелками в карточке «Что важнее».
    // У возрождения, лечения и еды есть пол 60 — ниже работы они не опустятся
    // ни настройкой, ни опечаткой
    "ВесаВажности": "",

    "МенятьКиркуПри": 25,

    // СКЛАД — куда носить добытое. Не задан НАРОЧНО, ровно как «Дом» ниже:
    // сундук у каждого свой, а выдуманная точка увела бы бота с полной сумкой
    // в чистое поле. Задаётся в панели или словом «!склад тут», стоя у сундука;
    // координаты ИГРОВЫЕ — те самые, что игра показывает игроку. Пока склада
    // нет, бот ищет сундук рядом (строка ниже).
    //
    // В ОКНЕ ЭТА ТОЧКА — НА ВКЛАДКЕ «НАСТРОЙКА РОЛИ», рядом с «Домом». Раздел
    // у неё прежний («склад»), и пятеро её соседей — «ИскатьСундукиРядом»,
    // «СоседниеСундукиВРадиусе», «РазгружатьсяСам»,
    // «РазгружатьсяПриСвободныхМестах», «ПовторРазгрузкиЧерезСекунд» — стоят
    // там же, где стояли. СВОЯ у копателя теперь одна — «ИскатьСундукиРядом»;
    // остальные четыре ОБЩИЕ и держатся на вкладке роли меткой, как «Склад» и
    // «Дом»: «СоседниеСундукиВРадиусе» с 29.08 (без неё «!склад тут» у
    // стражника, продавца и ИИ терял все сундуки, кроме одного), а три ручки
    // рейса — с 09.09, когда «сам иду на склад» перестало быть тем, что мог
    // включить один копатель из пяти ролей
    "Склад": null,
    "ИскатьСундукиРядом": true,

    // НАСКОЛЬКО ДАЛЕКО СМОТРЕТЬ ПРИ ВХОДЕ В МИР, блоков. Ноль — не искать
    // вовсе (то же, что снятая галочка выше).
    //
    // РУЧКОЙ ЭТО СТАЛО 09.09: двенадцать были ЗАШИТЫ В КОД, и повернуть их
    // хозяин мира не мог ничем. Цена не бумажная: радиус великоват — под склад
    // молча уходит соседский сундук, и уходит надолго; мал — бот не видит
    // своих и говорит «сундуков в радиусе N вокруг не вижу».
    //
    // Число это НЕ ТО ЖЕ, что у слова «!склад тут» (там восемь): «тут» говорит
    // человек, стоящий у своих сундуков, — восемь блоков он видит сам. При
    // входе в мир никто нигде не стоит, и мерить этим нечем.
    "СундукиПриВходеВРадиусе": 12,
    "СтавитьФакелы": true,

    // САМ ИДЁТ РАЗГРУЖАТЬСЯ ПРИ ПОЛНЫХ СУМКАХ. Прямая просьба заказчика («когда
    // заполнены все слоты — бот идёт разгружаться, тоже галочка в настройках»),
    // и следом жалоба «инвентарь у бота полный и он не идет». Выключают там, где
    // склад далеко: рейс на триста блоков стоит дороже недобранной сумки
    "РазгружатьсяСам": true,

    // ОСМАТРИВАТЬ СУНДУКИ КАЖДЫЙ РАЗ, КОГДА ПРИШЁЛ НА СКЛАД — то самое «каждое
    // возвращение домой сканировать все сундуки, чтобы потом ориентироваться».
    // Платится временем рейса: шестнадцать сундуков по четыре секунды — минута.
    // Тому, кто бегает на склад каждые пять минут, это не окупается
    "ОписыватьСкладПриРейсе": true,

    // БЕЖАТЬ ЛИ ДОМОЙ ЗА НЕДОСТАЮЩИМ МАТЕРИАЛОМ посреди задачи. Живой случай —
    // дорога, вставшая на середине с «мостить нечем», когда камня дома два
    // сундука. Выключают тому, чей дом в трёхстах блоках: там рейс стоит
    // половину смены
    "БегатьДомойЗаМатериалом": true,

    // Пара «сделать или сходить взять»: чем пополнять запасы, когда
    // недостающего нет ни в сумках, ни в сундуках. Прежде первая звалась
    // «КрафтитьПоПотребности» — старое имя ещё понимается. Вторая до этой волны
    // в пресете не стояла вовсе, хотя без неё бот не соберёт себе первый топор
    "КрафтитьНедостающее": true,
    "ДобыватьНедостающее": true,

    // ДОДЕЛАТЬ НАЧАТОЕ, пока делать нечего. Журнал 16.08, 13:11:51: бот вытесал
    // лезвие ножа («в сумке прибавилось: knifeblade-peridotite x1»), не нашёл
    // палки — и лезвие пролежало в сумке весь вечер, потому что цепочку запасов
    // спрашивают только перед нарядом. Теперь раз в минуту бот смотрит, не
    // осталось ли нехватки, которую можно закрыть НЕ СХОДЯ С МЕСТА, и закрывает
    // её. За палкой через полкарты он при этом не пойдёт — это дело наряда
    "ДоделыватьНачатое": true,

    // А ЭТА — СХОДИТЬ ЗА НЕДОСТАЮЩИМ. Живой случай 23.08: бот поднялся с
    // пустыми сумками, сам перечислил «Pickaxe: 0/1, Knife: 0/1, ladder: 0/64»
    // и закончил словами «в простое я за этим не хожу; не занимаю тело и жду».
    // И ждал: без кирки он не копает, не столбится и не выбирается из ямы,
    // драться ему было нечем. За девять минут умер дважды.
    //
    // Разница с «ДоделыватьНачатое» — в цене: та досбирает НА МЕСТЕ и никуда
    // не ходит нарочно, эта идёт на склад, домой, а если позволено
    // «ДобыватьНедостающее» — то и в мир. Копателю без кирки работы нет, ему
    // «да»; стражнику на посту уходить за ней незачем.
    //
    // Куда ходить и что собирать, решают всё те же «ДобыватьНедостающее» и
    // «КрафтитьНедостающее» — эта ручка их не обходит. Вес хозяйственный:
    // голод, рана и бой перебивают сборы без разговоров
    "СнаряжатьсяВПростое": true,
    "УходитьВРазведку": true,
    "ОбходитьПередКопанием": true,
    "РадиусОбхода": 64,
    "ТочекОбхода": 12,
    "ПодбиратьСамородки": true,

    // НА СКОЛЬКО БЛОКОВ БОТ ВИДИТ РУДУ СКВОЗЬ КАМЕНЬ, когда включён чит зрения
    // (без чита не значит НИЧЕГО: честный бот ищет открытую жилу в стене на
    // своих 10–32 бл). Потолок — 250: осмотр перебирает клетки шара, и на
    // большем радиусе один взгляд стоит секунд, то есть бот встаёт.
    //
    // ЖИВОЙ СЛУЧАЙ 19.08, словами заказчика: «сейчас читы на иксрей явно
    // неверно работают, бот искал с читом медь вокруг себя бегал, а не чётко
    // бежал к руде, которая была в 100 блоках». Чит работал ровно как настроен:
    // здесь стояло 48, а руда лежала в ста блоках — за пределом взгляда. Это
    // НАСТРОЙКА, а не поломка, и с 20.08 бот говорит это прямо: в итоге наряда
    // теперь стоит «осмотр на 48 бл СКВОЗЬ КАМЕНЬ (чит)», а прежнего приговора
    // «тут его, похоже, нет» больше нет — бот знает не про мир, а про свой
    // радиус.
    //
    // Хотите, чтобы бот бежал к дальней руде, — поднимайте ЗДЕСЬ. Цена честная:
    // 48 бл — это около миллиона вопросов к модели мира на каждый взгляд
    // (≈57 мс), 96 бл — полсекунды, 250 — секунды.
    "ДальностьРудыСквозьСтены": 48,

    // ЧЕГО СТОИТ МЕТАЛЛ, ЛЕЖАЩИЙ НА ЗЕМЛЕ, рядом с кремнём (3), кварцем (2) и
    // простым камнем (1). Наряд подбирает не всё подряд, а ДВЕНАДЦАТЬ находок,
    // и берёт их по этой самой ценности.
    //
    // Живой случай 19.08: щебень метеорита (loosestones-meteorite-iron-*)
    // роняет stone-meteorite-iron — пятьдесят единиц железа в штуке, и берётся
    // он РУКОЙ, без кирки четвёртого тира. «Металл ли это» бот уже спрашивал у
    // реестра и отвечал верно, а вот ЦЕНУ ему давала рукописная таблица
    // приставок, где такого кода нет: выходила единица, дешевле кремня, и в
    // дюжину находок метеоритное железо не попадало.
    //
    // Ноль — «металл на земле ничем не лучше камня»: осмысленно для бота,
    // которого послали за камнем.
    "ЦенностьМеталлаНаЗемле": 4,
    "ОкапыватьЖилу": true,

    // СКОЛЬКО БЛОКОВ СНИМАТЬ, ОКАПЫВАЯ ОДНУ ЖИЛУ. Галочка выше отвечает
    // «окапывать или нет», а это — «сколько», и до 20.08 такой настройки не
    // было вовсе: число (64) жило внутри бота и до файла не доезжало.
    //
    // ЖИВОЙ СЛУЧАЙ 20.08. Наряд «stone-meteorite-iron ×3»: бот выломал ЧЕТЫРЕ
    // клетки метеорита и получил пятнадцать кусков — втрое больше заказанного.
    // А потом снял вокруг сорок один блок, и ни один не был рудой:
    //   [руда] жила на виду кончилась — окапываю 41 камней
    //   [руда] окопал 41 камней — продолжения жилы нет
    //   [руда] выломано 4 бл руды; получено: soil-medium-none x43,
    //          stone-meteorite-iron x15 (пробито 1 камней, окопано 41)
    // Сорок три земли ради нуля руды: метеорит лежал у поверхности, и
    // оболочкой выработки оказался грунт, а не порода.
    //
    // Десять — ближний слой у последних добытых клеток: соседние куски руды в
    // игре разделены одним-двумя блоками, и на это его хватает. Больше — жила
    // берётся целиком, но с горой пустой породы; 0 — не окапывать вовсе
    "ОкапыватьНеБольше": 10,

    // СКОЛЬКО МЕШАЮЩИХ КАМНЕЙ ПРОБИВАТЬ — это ДРУГОЕ, чем строка выше: пробить
    // помеху, заслонившую УЖЕ ВИДИМУЮ клетку руды («до … мешает soil-medium в
    // … — убираю»). Ноль — не пробиваться вовсе, тогда бот будет ходить перед
    // стеной и не достанет
    "ПробиватьсяЧерез": 8,
    "ЛаваОстанавливает": true,

    // НЕ СТОЯТЬ ТАМ, ГДЕ ЖГУТ. Заказчик дословно: «на костре не стоять и на
    // любых других зонах с уроном - кипяток и лава например». Беда старая и
    // названная: бот сам сложил костёр, сам пришёл к нему греться, ВСТАЛ В
    // НЕГО и сгорел вместе с 48 стопками вещей — у блока костра нет коллизии,
    // для тела он воздух.
    //
    // Галочка только про УЙТИ. «Не вставать туда заранее» ею не выключается:
    // маршрут через лаву, кипяток, огонь и горящий костёр не строится вовсе —
    // это свойство места, как стена, а не настройка.
    "УходитьИзОгня": true,

    // Как далеко искать место, куда сойти с горящей клетки. Из костра и из
    // лужи выходят за шаг-два; шесть берут и разлившуюся лаву. Больше ставить
    // вредно: горит бот по два здоровья в секунду, и лишний перебор — это
    // здоровье
    "КудаУходитьОтОгняБлоков": 6,

    // ВО СКОЛЬКО РАЗ ДОРОЖЕ ШАГ ВПЛОТНУЮ К ОГНЮ — лаве, кипятку, горящему
    // костру. Не «в огонь» — В огонь маршрут не строится вовсе, это свойство
    // места, как стена, — а МИМО, по соседней клетке. Восьмёрка значит «обход
    // длиной до восьми лишних блоков лучше, чем шаг впритирку».
    //
    // Единица вернёт тот самый случай, что стоил бота и 48 стопок: он сложил
    // костёр на открытом месте, пошёл мимо по делам, и прямая между двумя
    // далёкими точками задела очаг. Много — бот станет трусом: греться и
    // готовить он всё равно обязан подойти вплотную.
    //
    // ЕДИНИЦА НЕ ПРОСТО СНИМАЕТ НАДБАВКУ — ОНА ВЫКЛЮЧАЕТ СТОРОЖА. Кроме цены
    // клетки эта же ручка держит заставу спрямления: она не даёт СПРЯМЛЁННОЙ
    // ПРЯМОЙ пройти впритирку к очагу между двумя далёкими точками маршрута.
    // Поставив 1, вы снимаете и её — а это и есть тот случай с 48 стопками,
    // потому что обе точки были от костра далеко, а линия между ними нет.
    // Раньше здесь про это не было ни слова (приёмка 27.08).
    //
    // Числа этого в пресетах не было ВОВСЕ — оно жило в библиотеке, и человеку
    // было сказано только про запрет ходить В огонь.
    "ЦенаШагаВплотнуюКОгню": 8,

    // КОГО СЧИТАТЬ ВРАГОМ — МЕТКАМИ САМОЙ ИГРЫ, через запятую. Это НЕ начала
    // имён: слова здесь те самые, что игра пишет в описании существа полем
    // tags и присылает боту в реестре типов.
    //   rust-creature — дрифтер, боуторн, шивер;
    //   ferocious     — волк, гиена, медведь, рой пчёл (и детёныши);
    //   boss          — эйдолон и эрель;
    //   mechanical    — локуст и колокол.
    // Последняя метка одна во всём наборе неточна: под неё попадают и ручные
    // машины — их отводит вопрос «а не чей ли он» (хозяин, commandable, tamed)
    // и список «МирныеКоды» ниже.
    //
    // Прежде тут (в библиотеке, без ручки) лежал рукописный список начал кодов
    // «drifter, wolf, locust, bell-», и он ошибался в обе стороны сразу:
    // «locust» ловил ВЗЛОМАННОГО локуста — чужого питомца, — а роя пчёл и обоих
    // боссов не знал вовсе. Пусто — не считать врагом никого.
    "ВражескиеМетки": "rust-creature, ferocious, boss, mechanical",

    // КОГО НЕ ТРОГАТЬ, ХОТЯ МЕТКИ ГОВОРЯТ ОБРАТНОЕ — куски кодов через запятую.
    // bellmini — спутник селянина-изобретателя: десять хп, держится у хозяина,
    // убегает от игрока, ни одной атаки. Колокол — сирена, зовущая дрифтеров.
    // Для КЛИЕНТА они неразличимы: одни и те же метки, один класс, одни и те же
    // клиентские поведения; всё, чем они на деле различаются, живёт в СЕРВЕРНЫХ
    // поведениях, а их в пакет не кладут вовсе.
    //
    // Работает список в БЕЗОПАСНУЮ сторону: лишняя запись здесь значит «не
    // трогай», а не «бей».
    "МирныеКоды": "bellmini",

    // НА СКОЛЬКО БЛОКОВ ПОДХОДИТЬ К КОСТРУ — «У КОСТРА», А НЕ «В КОСТРЕ».
    // Разница стоила бота и 48 стопок вещей: он сложил костёр, пришёл греться
    // и ВСТАЛ В НЕГО (у костра нет коллизии, для тела он воздух).
    // Дальше — холоднее: на 4,5 блока остаётся меньше пятой части тепла.
    // БЛИЖЕ 0,8 БОТ НЕ ПОДОЙДЁТ НИ ПРИ КАКОМ ЧИСЛЕ, и это не своеволие: игра
    // жжёт каждого, чья КОРОБКА задела клетку костра, а полширины тела 0,3 плюс
    // полклетки 0,5 — и есть та граница. Поставите меньше — подожмут.
    // ДО 27.08 ЧИСЛА ЗДЕСЬ НЕ БЫЛО НИ В ОДНОМ ПРЕСЕТЕ: оно стояло внутри
    // библиотеки, никто его не ставил, и зажим 0,8 не мог сработать никогда.
    "ПодходитьККостру": 1.6,
    "МинутНаНаряд": 30,

    // ЧТО ЗНАЧИТ «ДОБУДЬ 20 МЕДИ». Заказчик дословно: «я пишу добудь 20 меди, а
    // он добывает 20 кусков самородков, а не самородной меди, он не смотрит
    // сколько и всего». Так и было: журнал 16.08, 12:56:28 — «медь: принёс 29
    // из 30», а в сумке «ore-poor-nativecopper-andesite ×24,
    // ore-poor-nativecopper-peridotite ×5». Двадцать девять КУСКОВ бедной руды
    // это 29 × 15 = 435 единиц металла, то есть четыре слитка с хвостиком.
    //
    // Три значения: «Слитки» (сто единиц металла в каждом — так металл меряют в
    // игре, слиток это голова кирки), «Единицы» (те же единицы поштучно) и
    // «Штуки» (как было до этой волны: любые куски вперемешку).
    //
    // Единицы не наши: сколько металла в куске руды (бедный 15, средний 20,
    // богатый 25, щедрый 35) и сколько самородков идёт на слиток (двадцать)
    // приходит из реестра сервера. Перед каждым нарядом бот говорит вслух, как
    // он понял заказ, — эту строку и стоит читать первой.
    //
    // Уголь, кварц и самоцветы металлом не меряются ни при каком значении: у
    // них единиц металла нет вовсе, и наряд на них считается штуками
    "ВЧёмСчитатьМеталл": "Слитки",

    // ЗАКРЫВАТЬ ЗА СОБОЙ ДВЕРИ, которые бот открыл сам. Заказ дословно: «не
    // всегда закрывает за собой дверь». Живьём (журнал 16.08) бот прошёл два
    // проёма подряд, первый закрыл, а про второй — (512062, 112, 512252) —
    // замолчал на два часа: путь сорвался сразу за створкой, и дверь забылась
    // вместе с оборванным маршрутом. Открытая дверь в бурю или ночью пускает в
    // дом кого угодно.
    //
    // Снятая галочка НЕ МОЛЧИТ: про каждую оставленную дверь будет сказано
    // вслух с координатами — иначе человек нашёл бы её в мире через неделю и
    // назвал бы браком
    "ЗакрыватьЗаСобойДвери": true,

    // НА СКОЛЬКО ОТОЙТИ ОТ СТВОРКИ, ПРЕЖДЕ ЧЕМ ЗАКРЫВАТЬ ЕЁ НА ХОДУ, блоков.
    // 0 — закрывать сразу, как только дверь перестала быть по курсу.
    //
    // Вторая половина жалобы «дверь часто забывает закрыть и стоит с открытой
    // дверью» — не забывчивость, а МИГАНИЕ. Живьём (журнал 18.08,
    // 00:19:32–00:19:56) тело болталось между двумя створками одного тамбура
    // («упёрся на точке 2/9 …, стою (512062,5, 112, 512252,3)», «застрял,
    // перестраиваю маршрут»), курс перекладывался по нескольку раз в секунду,
    // и вместе с ним перекладывался ответ «нужна ли мне эта дверь». За
    // двадцать четыре секунды две створки открылись 14 раз и закрылись один; в
    // каком состоянии бот остановится — как повезёт.
    //
    // Полтора блока — тот шаг, дальше которого тело в тамбуре не уходит.
    // Спрашивается ТОЛЬКО НА ХОДУ: вставший бот сквозь эту дверь не идёт
    "ОтойтиОтДвериПередЗакрытием": 1.5,

    // ЗА СКОЛЬКО БЛОКОВ ДО ЦЕЛИ СБАВИТЬ ШАГ. Дальше — бегом, ближе — шагом.
    // 0 — не сбавлять вовсе, бежать до самой цели.
    //
    // Число висело в движении (Movement.SprintDistance) и не доносилось ни
    // одной ролью: повернуть его человеку было нечем. Цена замерена телом на
    // стенде: по голой земле бег 6,85 бл/с против шага 3,39; по сугробу
    // (snowlayer-7, множитель земли 0,65) — 4,45 против 2,2. Отсюда и вопрос
    // заказчика «особенно в конце»: последние блоки перед сундуком бот идёт
    // вдвое медленнее, а на снегу — втрое медленнее бега по чистому.
    //
    // ЧЕГО ЭТО НЕ ЧИНИТ. Правило спрашивается РАЗ НА ОТРЕЗОК МАРШРУТА, а не на
    // такте: на спрямлённом прямом пути отрезок один на весь поход, и бот
    // бежит до самой цели, что бы здесь ни стояло. На ломаном пути (точки через
    // блок) ручка работает. Сведение этих двух случаев в эту волну не вошло
    "СбавитьШагЗаБлоковДоЦели": 6,

    // СКОЛЬКО НЕ ДОВЕРЯТЬ СПРЯМЛЕНИЮ МАРШРУТА ПОСЛЕ ТОГО, КАК ОНО ПОДВЕЛО.
    // 0 — доверять всегда.
    //
    // Маршрут спрямляют: выкидывают промежуточные клетки, оставляя длинные
    // прямые, — так бот бежит, а не семенит лесенкой. Пройдёт ли тело по такой
    // прямой, решают КЛЕТКАМИ, а у тела есть коробки частичных блоков (плита,
    // тропа, сугроб), которых в этом счёте нет; да и мир между планом и
    // ходьбой меняется. Не дошёл до спрямлённой точки — бот винит спрямление и
    // следующий маршрут строит клетка за клеткой.
    //
    // Живой случай 19.08: «упёрся на точке 4/4 … до точки было 31 бл по прямой
    // — её поставило спрямление, а тело там не проходит». Без этой памяти
    // перезапуск пути давал ТОТ ЖЕ маршрут, и бот стоял.
    //
    // Больше — дольше ходит лесенкой там, где давно можно бежать; меньше —
    // упирается в ту же прямую снова и снова
    "НеДоверятьСпрямлениюСекунд": 60,

    // ДОЛЬШЕ СКОЛЬКИХ СЕКУНД НЕ МОЛЧАТЬ. 0 — молчать сколько угодно.
    //
    // Живой случай (ночь 18.08), дословно: «в логах записи не было, почему-то
    // они у бота не писались 20 минут целых, что странно». Бот в это время
    // работал: с 00:24:59 до 00:41:16 в журнале 25 строк на семнадцать минут, а
    // в минутах 00:26, 00:30, 00:31, 00:36, 00:38 и 00:40 нет ни одной. Пустой
    // журнал не отличает «занят делом» от «встал в цикле» и от «процесс умер».
    // Теперь бот обязан подавать голос: чем занят, где стоит, кто взял ход
    "МолчатьНеДольшеСек": 60,

    // ЛОМАТЬ ЛИ ЧУЖУЮ ПОСТРОЙКУ РАДИ ВЫХОДА. По умолчанию — НЕТ.
    //
    // Живой случай (ночь 18.08), дословно: «бот затупил выходить через дверь и
    // стал искать выход и ломать дом изнутри». Журнал 00:41:21–00:41:49: не
    // найдя дороги к позвавшему человеку, бот полез наверх ступенями и вырубил
    // пять брёвен debarkedlog-oak — стену и крышу дома заказчика.
    //
    // Свою выемку бот ломает как ломал: породу, землю, руду. Чужую постройку —
    // нет, и говорит об этом вслух. Не понял, чей блок, — тоже не ломает и
    // тоже говорит. Включают там, где бот копает в СВОЕЙ постройке и запертым
    // остаться не должен; чужую заявку сервера эта галочка не снимает никогда
    "ЛоматьЧужоеРадиВыхода": false,

    // ПО ЧЕМУ БОТ УЗНАЁТ ЧУЖОЙ ДОМ, У КОТОРОГО НЕТ ЗАЯВКИ СЕРВЕРА.
    //
    // Сундук, дверь, табличка, кровать, печь — вещи, которые ставит человек;
    // в породе их не бывает. Здесь сказано, в скольких блоках вокруг клетки их
    // искать. Живьём бот рубил дом заказчика в ТРЁХ клетках от его склада и в
    // двух от двери, которую сам открывает каждый вечер, — отсюда и тройка.
    //
    // Меньше — пролезет сквозь стену сарая (приметы окажутся за радиусом, и
    // бревно попадёт в «не понял, чьё», а не в «чужое»). Больше — откажется
    // копать руду под чужим погребом и встанет посреди своей штольни.
    // 0 — примет не искать вовсе: тогда чужое узнаётся только по заявке
    // сервера, своей памяти о поставленном и реестру блоков
    "ПриметыПостройкиИскатьВРадиусе": 3,

    // НАСКОЛЬКО ВОКРУГ ОТМЕЧЕННЫХ ДОМА И СКЛАДА НИЧЕГО НЕ ТРОГАТЬ, блоков.
    // Отказ бота уже называл эту настройку по имени («радиус задаёт настройка
    // ДомИСкладБерегуВРадиусе»), а повернуть её было нечем: ручки не было ни у
    // одной роли и ни в одном пресете. Шесть сняты с дома заказчика: отметки
    // (62, 122, 255) и (62, 112, 255), дверь в трёх блоках от складской.
    // Ноль — беречь двор только по прочим приметам (заявки сервера, двери и
    // сундуки рядом, рецепт сетки у блока).
    "ДомИСкладБерегуВРадиусе": 6,

    // ЛОМАТЬ — КРАЙНЯЯ МЕРА, А НЕ ПЕРВЫЙ ОТВЕТ НА ОТКАЗ ПОИСКА.
    //
    // Живой случай — та же ночь 18.08, слова заказчика дословно и дважды:
    // «зачем ломать, если у него был выход из дома в виде двери и он мог просто
    // побежать»; «и снова нет, зачем ломать, если был путь, ломать крайняя мера
    // же». В журнале 00:41:16–00:41:49 поиск ответил «дороги нет», и СЛЕДУЮЩЕЙ
    // же строкой бот полез вверх сквозь стену — не сделав ни шагу в обход. А
    // минутой раньше он прошёл этой самой дорогой, открыв дверь: не справился
    // ПОИСК, а расплатилась кирка.
    //
    // Теперь ходьба перебирается до конца, и только потом берётся кирка:
    // искать шире и дольше -> подойти к цели с другой стороны -> дальний обход.
    // Эти два числа — про то, СКОЛЬКО ходьбы перебрать; отключить само правило
    // ими нельзя, и ручки такой нет нарочно.

    // На сколько блоков уйти в сторону от прямой, чтобы посмотреть дорогу
    // оттуда. 0 — дальним обходом не ходить (кирка тогда всё равно последняя,
    // просто ходьба кончается раньше)
    "ОбходитьПередЛомкойБлоков": 24,

    // В каком радиусе вокруг цели искать другую клетку, куда встать. Живьём
    // цель была клеткой ПОЗВАВШЕГО ЧЕЛОВЕКА («не хватает 1 бл по высоте») —
    // в неё не встанет и человек, а рядом места полно. 0 — не искать
    "ПодходКЦелиИскатьВРадиусе": 3,

    // СМАХИВАТЬ ЛИ С ДОРОГИ И С ПРИЦЕЛА НИКЧЁМНУЮ МЕЛОЧЬ: снег, траву, цветок,
    // папоротник. По умолчанию — ДА, и это НЕ то же самое, что «ломать чужое».
    //
    // Прямой вопрос заказчика (19.08), дословно: «а почему он увидел
    // непроходимую преграду — снег — и решил лезть наверх, а не напрямик
    // сломать и выйти из дома?» Перед ботом лежал слой снега высотой 0,125,
    // а он полез НАВЕРХ НА ЧЕТЫРЕ БЛОКА: лестница, столб, ступени — и всё
    // впустую. Тем же вечером, 21:12, тот же снег восемь раз подряд за четыре
    // секунды перекрыл ему ЛУЧ до найденного метеорита: «до (512059, 112,
    // 512281) нет прямой видимости: мешает snowlayer-2 в (512059, 113,
    // 512281)» — а снег лежал в клетке его собственных ног.
    //
    // Что считать мелочью, решает РЕЕСТР ИГРЫ, а не список кодов: игра сама
    // зовёт такие блоки заменяемыми (под них не подкапываются, их затирают,
    // ставя блок), выпадений с них тем, что в руке, нет, и ломаются они голыми
    // руками. Чей это блок, по-прежнему решает правило владения: на чужом
    // привате не смахнётся и травинка.
    //
    // Выключают там, где боту нельзя махать руками вовсе. Тогда снег снова
    // станет преградой, и об этом будет сказано вслух каждый раз
    "СметатьМелочьСДороги": true,

    // ДОЛЬШЕ СКОЛЬКИХ СЕКУНД БЛОК МЕЛОЧЬЮ УЖЕ НЕ СЧИТАЕТСЯ.
    //
    // Мерка снята с реестра игры: у snowlayer сопротивление 0,2–0,8, у травы и
    // папоротника 0,25–0,5 — всё это меньше секунды голой рукой. Бревно и
    // камень сюда не попадают ни при каком инструменте, и это нарочно: рубить
    // по дороге лес живой игрок не станет, он обойдёт.
    //
    // Больше — бот начнёт «убирать с дороги» всё, что ломается за пару секунд,
    // то есть встанет на просеку вместо ходьбы. 0 — мелочью не считать ничего
    "МелочьЛомаетсяНеДольшеСек": 1,

    // ШУМ ПРО ЗДОРОВЬЕ В ЖУРНАЛЕ. Живой прогон 16.08, 20:22:50 — 20:23:16:
    // двадцать строк «Получено 0,7 хп от heal» подряд, а «Потеряно 0,13 хп от
    // hunger» каплет каждые шесть секунд весь день. Минута молчания сводит и то,
    // и другое к одной строке с суммой («вылечился на 14 хп за 30 с»), а удар
    // живого противника не глушится никогда — он редок и важен.
    // Поставьте 0, когда разбираете прогон построчно: тогда печатается каждая
    // строка сервера, как было раньше
    "ПовторыПроЗдоровьеРежеСекунд": 60,

    // КОСТЁР, КОТОРЫЙ НЕЧЕМ РАЗВЕСТИ. Живой прогон 19.08, с 18:27:54 до
    // 18:33:39 — ШЕСТЬ МИНУТ по четыре одинаковые строки каждые двадцать
    // секунд:
    //   [руки] в руку брать нечего: подходящего предмета нет ни в хотбаре, ни в сумках
    //   [огонь] дров нет
    //   [руки] в руку брать нечего: подходящего предмета нет ни в хотбаре, ни в сумках
    //   [огонь] нечем поджечь (нужно firestarter)
    // Бот при этом мёрз на 100 % (тело 31 °C — ниже игра тело не остужает).
    // Отказ честный, но за семьюдесятью двумя повторами в журнале не видно
    // ничего другого.
    //
    // Теперь отказ говорится ОДИН раз, и бот к костру больше не ходит. Дрова
    // или огниво появились в сумках — пробует снова В ТОТ ЖЕ МИГ, без всякого
    // срока. Число здесь про другое: хозяин мог положить поленья в дальний
    // сундук, и об этом бот не узнает никак. Десять минут — мерка снабжения;
    // ставьте 0, когда разбираете прогон построчно
    "ПробоватьКостёрСноваЧерезМин": 10,

    // ДО СКОЛЬКИХ ГРАДУСОВ ГРЕТЬСЯ, РАЗ УЖ ВСТАЛ К ОГНЮ. Градусы ТЕ, ЧТО ИГРА
    // ПИШЕТ НА ЭКРАНЕ ПЕРСОНАЖА (клавиша C): 37 — норма, 37,8 — потолок, выше
    // тело не нагревается никогда. Сырых 45 сюда писать не надо: перевод
    // делает сам бот, и в файле стоит то же число, что человек видит в игре.
    //
    // ПРЯМОЙ ЗАКАЗ 20.08: «логику нужно починить, что если герой замерз и стал
    // греться, то греемся до макс температуры своей». Живой журнал 19–20.08
    // повторял одну и ту же строку с одним и тем же числом: «мёрзну на 6 %
    // (тело 34,8 °C) — одеваюсь и ищу тепло» (18:33:51, 21:13:07, 00:06:07).
    // Бот доводил тело ровно до порога «перестал мёрзнуть» и уходил, а через
    // минуту мёрз снова.
    //
    // Поставьте меньше, если бот нужен в забое, а не у огня: 37 — «до нормы»,
    // 36 — «лишь бы перестал мёрзнуть». Сколько терпеть у слабого костра, эта
    // настройка не решает: перестал греть — бот уходит и говорит об этом
    // ЧИСЛО ВЫГЛЯДИТ СТРАННО, И ЭТО НАРОЧНО. Ручка объявлена double, а
    // заводское берётся у float-постоянной игры (BodyHeat.HottestShownTemperature
    // = 37,8 °C); при расширении float→double и выходит этот хвост. Округли мы
    // его до 37.8 — бот вёл бы себя ТАК ЖЕ (код сужает обратно до float), но
    // окно управления показало бы ручку ПЕРЕКРУЧЕННОЙ: «изменена» считается
    // побайтовым сравнением с заводским (RoleDefaults.Same), и человек искал бы,
    // кто и зачем трогал температуру. Пишем ровно заводское
    "ГретьсяДоТемпературы": 37.79999923706055,

    "Здороваться": true,

    // ДОМ. Не задан нарочно: клетка у каждого своя, и выдуманная точка увела
    // бы бота в чистое поле. Задаётся в панели или словом «!дом тут», стоя на
    // месте. Пока дома нет, буря, сон и точка возрождения честно откажутся.
    //
    // ЗАДАННЫЙ В ПАНЕЛИ ДОМ ТЕПЕРЬ ПЕРЕЖИВАЕТ ПЕРЕЗАПУСК. Раньше не переживал:
    // панель писала накрученное в ЭТОТ ЖЕ файл рядом с ботом, а следующая
    // сборка (у хозяина — распаковка новой версии) клала поверх исходный, где
    // «Дом»: null. Живой случай 15.08: в 21:11 дом задан и работает, в 22:01
    // после перезапуска — «дом не задан — отмечать нечего». Теперь свои пресеты
    // ложатся в отдельную папку (PresetLibrary.Folders), и обновление их не
    // трогает
    "Дом": null,

    // СОН. Кровати у копателя в забое нет, и это нормально: он честно скажет в
    // журнале, где искал и чего не хватает. Тридцать два блока — «кровать дома,
    // а забой рядом»; для дальней штольни это значит «сегодня не сплю», и так и
    // будет сказано. Выключают сон там, где ночь — самое рабочее время
    "СпатьНочью": true,
    "ЗаКроватьюНеДальше": 32,

    // НОЧЬЮ ИДТИ ДОМОЙ, ЕСЛИ КРОВАТИ РЯДОМ НЕТ, — и уже там её искать.
    // Сильнее «ЗаКроватьюНеДальше»: та мерка про случайную кровать, а свой
    // дом человек назвал сам. Выключите — бот останется работать и скажет
    // в журнал, что домой не идёт и по чьей воле.
    "ДомойЗаКроватью": true,

    // ТОЧКА ВОЗРОЖДЕНИЯ ДОМА. Ставится ВРЕМЕННОЙ ШЕСТЕРЁНКОЙ, и та тратится —
    // но возродиться в четырёхстах блоках от своей кирки дороже. Кровать
    // точку возрождения в Vintage Story не ставит вовсе (проверено по сборкам
    // 1.22.6), так что другого способа нет
    "ОтмечатьДом": true,
    "ДомДальше": 500,
    "ДопускДома": 4,

    // ЧУЖИЕ ВЛАДЕНИЯ. Заказчик просил держаться от приватов на 500 блоках при
    // автопоиске. Границы заявок присылает сам сервер — это тот же список, по
    // которому разметка приватов рисуется на карте живому игроку.
    // ИзбегатьИгроков выключено: при 500 блоках один прохожий выгнал бы бота
    // с половины карты
    "ДержатьсяОтЧужого": 500,
    "ПомнитьЧужоеМинут": 30,
    "ПомнитьИгроковМинут": 5,
    "ИзбегатьИгроков": false,

    // ПАМЯТЬ ВСТРЕЧЕННОГО. Трое суток игрового времени: копатель проходит мимо
    // руды, которую не взял, и возвращаться туда дешевле новой разведки.
    // Живёт только в ОЗУ — перезапуск бота её стирает
    "ПомнитьЧасов": 72,
    "ПомнитьДальше": 64,
    "КопатьВнизЗаКамнем": 8,

    // ПРОСТОЙ СНАЧАЛА ЗАКРЫВАЕТ ХВОСТЫ, и только потом смотрит на «БезДела».
    //
    // ХВОСТ — то, что бот начал и не закончил: своя открытая дверь, свои
    // временные леса, прерванная работа, ждущая возврата. ЖИВОЙ СЛУЧАЙ: дверь
    // (512062, 112, 512252) простояла нараспашку два часа, а бот за это время
    // четырежды бездельничал — «без дела 60 с — стою, так настроено» в 13:01,
    // 13:07, 13:14 и 13:27. Долг за дверь тикал только на ходу, а бот стоял.
    //
    // НЕДОДЕЛАННЫЙ ИНСТРУМЕНТ СЮДА НЕ ВХОДИТ: его доделывает соседняя ручка
    // «ДоделыватьНачатое» выше. Две ручки на одно решение — это ручка, которая
    // ничего не выключает
    "ЗакрыватьХвостыВПростое": true,

    // БЕЗ ДЕЛА. «Стоять» — потому что копателя запускают под опыт: бот, ушедший
    // бродить или вышедший из игры посреди наблюдения, портит опыт.
    // Команды из чата открыты: копателем командуют словом.
    //
    // Слова ровно четыре: Стоять, Бродить, Домой, Выйти — и в окне управления
    // они теперь выбираются СПИСКОМ, а не набираются вслепую. «Домой» и
    // «Бродить» требуют заданного дома (ручка «Дом» выше)
    "БезДела": "Стоять",
    "ПорогБезделья": 60,
    "РадиусПрогулки": 12,

    // ЦИКЛ ЗАДАЧ В ПРОСТОЕ: Нет, Пройти, ПоКругу. Заказ человека дословно —
    // «допустим задавать цикл задач, если они есть». Список работ берётся ТОТ
    // ЖЕ, что человек набирает в окне управления на вкладке задач; второго
    // списка нет и не будет.
    //
    // «Нет» — потому же, почему и «Стоять»: очередь пускает человек, а бот,
    // взявшийся за неё сам посреди наблюдения, портит опыт. Поставьте «Пройти»,
    // чтобы простой доводил набранную очередь до конца, или «ПоКругу», чтобы он
    // гонял её всю ночь; пустой круг (ни одной сделанной задачи) не повторяется
    "ОчередьЗадачВПростое": "Нет",

    // Заход, не сдвинувший незакрытое, через минуту упрётся в ту же помеху —
    // непрогруженный чанк под лесами, дверь вне досягаемости, палка, которой нет
    // нигде. Десять минут: тот же срок, которым живёт безнадёга запасов
    "НеБратьсяЗаБезнадёжноеМинут": 10,

    "КомандыИзЧата": true,

    // РАДИОТИШИНА — ОТДЕЛЬНАЯ РУЧКА, и это ответ на прямой вопрос заказчика
    // 16.08: «Команды из чата … дает радиотишину?». Не даёт: соседняя строка
    // выше — про УШИ, эта — про рот. С закрытым чатом бот в том же прогоне писал
    // «Мощу дорогу. „!стоп“ — прервать» и полный отчёт о наряде, отданном ИЗ
    // ОКНА. Снимите — и в чат не уйдёт ни одна строка, которую бот сочинил сам
    // (проглоченное ложится в журнал пометкой «[молчу]»). Ответ живому человеку,
    // приветствие и жесты при этом остаются: у них свои ручки ниже
    "ПисатьВЧатОСвоихДелах": true,

    // ДЛИНА СТРОКИ В ЧАТЕ, букв. Живой случай 20.08, 00:01:30: весь отчёт о
    // дороге (700+ букв — ряды, клетки, коды блоков, координаты, две ручки роли
    // по имени и разбор нехватки камня) ушёл в общий чат одной репликой. Слова
    // заказчика: «в игре это простыня на пять строк». Теперь в чат идёт голова
    // отчёта с хвостом «…(целиком — в журнале и окне управления)», а целая
    // строка — в журнал. 220 ≈ две строки чата при обычной ширине окна;
    // 0 — не резать вовсе, как было раньше
    "ДлинаСтрокиВЧате": 220,

    "ПрощатьсяПередУходом": "",

    // ФОНАРЬ В ЛЕВОЙ РУКЕ. Копатель работает в темноте, и правая рука ему нужна
    // под кирку. За левую руку игра берёт 20% скорости голода — поэтому только
    // в темноте и обратно в сумку на рассвете
    "ФонарьВРуке": true,
    "ФонарьВЛевойРуке": true,
    "ФонарьТолькоВТемноте": true,
    "УбиратьФонарьДнём": true,

    // ФОНАРЬ И В ПЕЩЕРЕ, а не только ночью. Заказчик дословно: «Фонарь нужно
    // использовать ночью и в пещерах (но сделай доп настройкой)». Живой журнал:
    // «09:06:58 убрал lantern-large-up… рассвело» — и до 09:23 бот работал в
    // штольне без света, потому что по часам был день.
    //
    // «Пещера» — не догадка про высоту, а факт от сервера: карта поверхности
    // приходит пакетом 17, глубина считается по ней. Шесть блоков потому, что
    // солнце идёт вниз по открытой колонне БЕЗ ослабления: на дне карьера в три
    // слоя (умолчание «ГлубинаКарьера») днём светло, а пещера закрыта породой.
    // Меньше — бот зажжёт фонарь в собственном карьере в полдень и заплатит за
    // это 20% скорости голода
    "ФонарьВПещере": true,
    "ПещераГлубжеБлоков": 6,

    // ПОРОГИ РАЗВЕДЕНЫ НА ДВА НАПРАВЛЕНИЯ — «зажечь» и «убрать» разными
    // числами. Живой журнал 16.08, ПОЛДЕНЬ: бот бил наклонный ход вверх и
    // полсотни раз подряд взял и убрал фонарь — пары через 0,5–1 с, медиана
    // 0,9 с. Дребезжало не время суток, а МЕСТО: глубина под небом ходила
    // вокруг шести, шаг под кровлю — пещера, шаг обратно — уже нет.
    //
    // Под землю бот уходит на шести блоках, а выходит обратно на трёх; свет
    // зажигает ниже 6 и убирает от 10; на рассвете держит фонарь ещё час. Между
    // порогами держится ПРЕЖНЕЕ решение. Поставьте пару одинаковых чисел —
    // дребезг вернётся
    "ПоверхностьНеГлубжеБлоков": 3,
    "ФонарьУбиратьПриСветеОт": 10,
    "ДержатьФонарьПослеРассветаЧасов": 1,

    // ЗАПАС ПО ВРЕМЕНИ поверх запасов по числам: источников темноты три (свет
    // чанка, глубина, часы), и они сменяют друг друга — смену источника никакой
    // полосой не погасить, только временем
    "НеТрогатьФонарьСекунд": 20,

    // ПРИВЕТСТВИЕ. Эмоция требует свободной ПРАВОЙ руки — с фонарём в левой
    // она проходит. Нет мода эмоций или права chat — поздоровается словом и
    // так и скажет в журнале
    "МахатьИгрокам": true,
    "МахатьРазВМинут": 10,
    "РадиусПриветствия": 12,
    "ЭмоцияПриветствия": "wave",
    "ЗдороватьсяСловомБезЭмоции": true,
    "ТекстПриветствия": "Привет, {0}!",
    "ПомнитьВстречиДней": 30,
    "ПомнитьЛюдейНеБольше": 500,

    // Бегство. Два РАЗНЫХ числа: ближе восьми блоков — бежим, оторвались на
    // восемнадцати — отпускаем тело. Пока это было одним числом, побег
    // кончался, не начавшись, и бот полминуты не двигался вовсе
    "БежатьБлиже": 8,
    "ЗакладыватьсяВУглу": true,

    // СКОЛЬКО СЕКУНД ТЕРПЕТЬ УДАРЫ, ПРОДОЛЖАЯ СВОЁ ДЕЛО. Три-четыре удара по
    // кулдауну дрифтера.
    //
    // ЖИВОЙ СЛУЧАЙ, ради которого это число названо здесь вслух (журнал 19.08):
    // одна и та же строка четырежды за минуту — «не связываюсь: если не
    // трогать, за 10 с снимет около 10,1 хп», — и всё это время дрифтер бил
    // бота. Терпение выдавалось заново каждые полсекунды и потому не кончалось
    // никогда. Теперь оно РАСХОДУЕТСЯ: секунды считаются от начала избиения, и
    // когда они вышли, «занимаюсь своим» перестаёт быть ответом — бот дерётся,
    // уходит или закладывается, а если не выйдет ничего, дерётся тем, что есть,
    // и говорит об этом вслух.
    //
    // Больше — бот терпеливее и реже бросает кирку из-за задевшей его твари;
    // меньше — раньше срывается разбираться. Ноль поставить нельзя: это
    // означало бы «стоять под ударами бесплатно», и снизу стоит полсекунды
    "ТерпетьУдарыСекунд": 10,

    // КОГДА НОСИТЬ БРОНЮ — И, ТЕМ САМЫМ, КОГДА ЕЁ СНИМАТЬ. Жалоба заказчика
    // дословно: «не снимал броню после шторма и опасности». Бот просидел восемь
    // минут в укрытии среди дрифтеров, а снятие висело на самой узкой ветке боя
    // («врагов не видно ВООБЩЕ») и не сработало ни разу.
    //
    // Броня стоит дорого, и это числа игры, а не мнение: полный комплект лат —
    // это −42 % скорости и +72 % расхода еды (walkSpeed −0,14 и hungerrate
    // +0,24 на каждую из трёх частей, ассеты 1.22.6 armor.json; складывает их
    // ModSystemWearableStats из VSSurvivalMod.dll). Кольчуга дешевле впятеро.
    // Копателю поставлено «ПокаРядомОпасно»: пока тварь поблизости, свежа обида
    // или идёт временная буря — в броне, стало тихо — снял и пошёл копать
    // налегке. Другие значения: «Никогда», «ВБою», «Всегда» (для сторожа на
    // посту, который никуда не бежит)
    "НоситьБроню": "ПокаРядомОпасно",

    // ВРЕМЕННЫЕ РАЗЛОМЫ. Ниже 0,2 стабильности сервер бьёт временным уроном
    // каждые четыре секунды. Куда уходить, бот решает по фактам: вплотную к
    // разлому — отойти, иначе подняться выше. Выключают тому, кто нарочно копает
    // в гнилых местах и лечится
    "УходитьПриНизкойСтабильности": true,

    // КАРТА ТРАНСЛОКАТОРОВ — адрес чужой карты сети. ПУСТО НАРОЧНО: зашитый
    // адрес работал бы ровно на одном сервере и молча врал бы на любом другом.
    // Пока адреса нет, весь счёт по сети лежит мёртвым грузом — и об этом бот
    // говорит сам, а не молчит
    "КартаТранслокаторов": "",

    // Выбраться из ямы. Копателю разрешено целиком: он и так дырявит породу,
    // а остаться на дне собственного карьера дороже испорченного потолка
    "ВыбиратьсяНаверх": true,
    "ПопытокПодъёма": 4,
    "ПробиватьсяВверхДо": 24,
    "ДобыватьМатериалНаСтолб": true,

    // СПЕРВА К СТЕНЕ. На дне широкого карьера над головой чистое небо, и
    // прежний ответ был «пробиваться наверх некуда»: столб посреди ямы выводит
    // на верх палки 1×1, откуда не слезть. Шестнадцать блоков — это осмотр
    // 1089 клеток, зовётся он только когда бот уже застрял
    "ИскатьСтенуВРадиусе": 16,
    "ВысотаСтеныДляПодъёма": 3,

    // ПРИСЕД. Просьба заказчика дословно: «научи видеть высоту припятствия,
    // некоторые можно пройти в присяд». Приём не стоит НИЧЕГО — ни блока не
    // сломано, ни блока не положено, — и потому в переборе выходов он ПЕРВЫЙ,
    // раньше даже «смахнуть мелочь с дороги»: это прямое продолжение слов
    // «зачем ломать, если был путь».
    //
    // ЧЕСТНО О ГРАНИЦЕ, чтобы не ждать от него лишнего. Присед в игре
    // укорачивает САМУ коробку тела множителем 0,8
    // (EntityPlayer.updateEyeHeight, 1.22.7): рост 1,85 → 1,48, глаза
    // 1,7 → 1,36. Это выигрыш в 0,37 бл, а НЕ целый блок: щель ровно в клетку
    // не берётся ни стоя, ни пригнувшись — там нужна кирка. Приём открывает
    // ровно те щели, где потолок висит не по границе клетки: перевёрнутая
    // плита (просвет 1,5), перевёрнутая ступень, тёсаный полублок, люк — и
    // ходы, где ноги стоят на плите (такие ступени копатель кладёт сам,
    // stonepathslab).
    //
    // Цена: под самой щелью бот идёт втрое медленнее — присед в игре это ×0,35
    // (GlobalConstants.SneakSpeedMultiplier). Выключают тому, кому важнее темп
    "ХодитьВПрисяде": true,

    // Насколько длинный низкий ход бот берётся пройти на корточках, клеток.
    // Четыре — это ход под мостом, под лестничным маршем, под свесом дома: то,
    // у чего видно другой конец. Дальше начинается «ползу неизвестно куда»:
    // за низким ходом может не быть выхода вовсе, а разворачиваться в нём дорого
    "НизкийХодДлинойДо": 4,

    // За сколько клеток по курсу бот вообще ЗАМЕЧАЕТ низкий ход. Приём зовётся,
    // когда дороги нет, а стоять бот при этом может и не вплотную к щели:
    // маршрут отказывает от старта, а щель в десятке шагов. Дюжина — это то,
    // что живой игрок видит и понимает с места; дальше начинается не «вижу
    // проход», а «гадаю по невыгруженным чанкам»
    "ЗамечатьНизкийХодЗа": 12,

    // МОСТ ЧЕРЕЗ РАЗРЫВ. Слова заказчика: «мосты строить он не умеет, нужно
    // чуть выдвинутся вперед с зажатым шифтом и ставить блок глядя на боковую
    // стенку (как в майнкрафте)». Он описал приём живого игрока точно, и бот
    // теперь делает ровно его: держит шифт всю переправу (присед не даёт сойти
    // с кромки — HandleSneaking в игре отменяет шаг за край по каждой оси
    // отдельно), кладёт блок под будущие ноги, целясь в БОКОВУЮ грань уже
    // стоящего блока, и шагает на него.
    //
    // Порядок цен соблюдает сама механика: сперва прыжок (0 блоков), потом
    // мост. За разрывом, где вставать не на что, мост не предлагается вовсе —
    // «мост туда кончится над пустотой».
    //
    // Эти четыре ручки жили ТОЛЬКО в окне управления, а в файле пресета их не
    // было вовсе — то есть повернуть их заранее было нечем
    "МоститьРазрывы": true,
    "МоститьРазрывДо": 4,
    "ПопытокМоста": 2,

    // Предел самого механизма стройки, блоков: отдельное число от порога
    // решения выше. Решает движение («стоит ли»), а строит стройка («смогу
    // ли»), и один общий предел скрыл бы, кто именно отказал
    "ПределМостаСтройки": 8,

    // СПУСК С ОБРЫВА — обратная сторона моста: спрыгнуть, ступенями, лестницей
    // по стене или разбирая породу под собой. Что дешевле, решает механика;
    // спрыгнуть она вправе только по двум разрешениям сразу — смелости роли и
    // бюджету урона прямо сейчас. Двадцать четыре блока — предел осмотра дна:
    // не видно дна ближе — вниз не лезем
    "СпускатьсяСОбрывов": true,
    "СпускатьсяСВысотыДо": 24,
    "ПопытокСпуска": 2,

    // ШТОЛЬНЯ — ХОД К РУДЕ ЗА СТЕНОЙ, и до 29.08 ни одно из этих четырёх
    // чисел повернуть было НЕЧЕМ: они жили в библиотеке (Tunnel.*), и ни
    // одного присваивания им во всём проекте не стояло.
    //
    // ВЫСОТА ХОДА — ДВЕ КЛЕТКИ, И ЭТО РОСТ ТЕЛА, а не круглое число: игра
    // 1.22.7, player.json, «hitboxSize.y: 1.85», округление вверх делает сама
    // физика игрока. Поставить ниже можно, но бот откажется ДО ПЕРВОГО УДАРА
    // и назовёт эту самую ручку: такую нору он выкопает, а пройти по ней не
    // сможет.
    //
    // ЭТО НЕ «ВысотаТоннеляДороги» И НЕ ПЯТЬ, И ЭТО НАРОЧНО. Пять сказано про
    // ДОРОГУ, дословно: «высоту спуска надо поднять, и сделать настраиваемой
    // У ДОРОГИ». Там полоса в три клетки, по ней ходят и в ней РАБОТАЮТ —
    // мостят полотно, ставят блоки над головой. Штольня — ход в ОДНУ клетку:
    // раз туда, раз обратно, строить в нём нечего, и каждая лишняя клетка
    // высоты это лишний ряд породы на всю длину хода. Нужен полный тоннель —
    // поставьте здесь ту же пятёрку, ручка на то и заведена.
    //
    // ВЫХОД ИЗ ЯМЫ И ИЗ ВОДЫ ЭТА РУЧКА НЕ ТРОГАЕТ: ступени наверх бот рубит в
    // рост тела при любом числе здесь. По ходу к руде ходят раз туда и раз
    // обратно, а по ступеням поднимаются ОДИН раз и уходят — лишняя клетка
    // там обошлась бы в лишний ряд породы на КАЖДУЮ ступень
    "ВысотаШтольни": 2,

    // Спрыгнуть в ходе бот согласен на три блока: игра начинает бить за
    // падение примерно с 3,5. Ноль — не спрыгивать вовсе, тогда над каждой
    // пустотой штольня либо заделает пол, либо честно встанет
    "СпрыгиватьВХодеДо": 3,

    // Осыпавшийся потолок — это засыпанный ход и бот под ним
    "СледитьЗаПотолкомХода": true,

    // Колодец вдвое дешевле лесенки (у лесенки на каждый блок спуска шаг в
    // сторону), а силы на подъём бот считает ДО спуска, а не на дне
    "ВнизКолодцемАНеЛесенкой": true,

    // Дорога. Три клетки — это полоса, по которой расходятся двое; шире
    // девяти край полотна выходит из-под руки бота. Коды покрытия оставлены
    // пустыми НАРОЧНО: чем мостить, бот выбирает из того, что в сумках, по
    // реестру сервера — вписанный сюда код чужого мода означал бы отказ
    // «нужного покрытия нет» на ровном месте.
    //
    // Перепад берётся ступенькой «блок, полублок на блок той же высоты что
    // дорога» — так просил заказчик. Отдельного кода ступени тут больше нет:
    // игровых блоков-ступеней дорога не кладёт и не крафтит, нужен только
    // полублок на верх ступеньки
    "ШиринаДороги": 3,

    // ВЫСОТА ТОННЕЛЯ ДОРОГИ — сколько клеток вычищается НАД полотном.
    //
    // ПЯТЬ — ОКОНЧАТЕЛЬНОЕ СЛОВО ЗАКАЗЧИКА, дословно 16.08: «5 блоков высота
    // от низа тоннеля, в высоту тоннель, а то бот не может его застраивать».
    // 29.08 он сказал иначе («я думаю в высоту 4»), два его же числа разошлись,
    // и на прямой вопрос про это противоречие он выбрал ПЯТЬ. Спор решён не
    // старшинством даты, а вопросом ему самому: число — политика, и хозяин у
    // неё один.
    //
    // НИЖЕ ЧЕГО НЕЛЬЗЯ — ВЫВЕДЕНО ИЗ ИГРЫ, А НЕ НАЗНАЧЕНО.
    //   На ровном ходу — ДВЕ клетки: рост тела 1,85 (player.json, hitboxSize.y).
    //   На СПУСКЕ — ТРИ. Вниз бот входит в новый ряд НА ПРЕЖНЕЙ ВЫСОТЕ: он
    //   стоит на уже выкопанном прошлом ряду, бьёт перед собой, шагает вперёд
    //   и лишь потом опускается. Значит нужны две клетки роста ПЛЮС сам шаг
    //   вниз, а шаг этот не больше одной клетки — круче полублока за ряд
    //   полотно не идёт. 2 + 1 = 3.
    // Меньше — честный отказ ДО ПЕРВОГО УДАРА, с числом для этой ручки.
    // Молча ваше число никто не поправит.
    //
    // Цена честная: каждый лишний блок высоты — ещё один ряд клеток на всю
    // длину дороги. Пятёрка оставляет две клетки запаса над макушкой на ровном
    // ходу: в них бот замахивается киркой на потолок и ставит блок над головой
    "ВысотаТоннеляДороги": 5,

    // ГЛУБИНА ВЫЕМКИ ДОРОГИ — насколько глубоко под землю бот уводит полотно,
    // блоков. Живой случай 16.08, 20:30:25: «у (512059, 107, 512241) полотно на
    // заданной высоте 107,5 разошлось с землёй на −4,5 бл — выемку глубже 4 бл
    // не роем». Дорога встала ровно на этом пределе, не добрав полблока, а
    // повернуть его было НЕЧЕМ: четвёрка сидела в библиотеке, и отказ даже не
    // мог назвать, что крутить. Теперь называет — имя этой ручки уходит в него.
    //
    // ТОЛЬКО ВНИЗ. Провал ПОД полотном этой ручкой больше не меряется: бот его
    // мостит, а мосту глубина провала безразлична — настил один слой блоков и
    // над ямой в блок, и над пропастью в пятьдесят. 22.08 в 17:18:35 бот сам
    // написал «тут нужен мост» и тут же встал по этому пределу, отдав 0 рядов
    // из 29.
    //
    // ДВЕНАДЦАТЬ, А НЕ ЧЕТЫРЕ. Прежняя цена ручки была посчитана неверно:
    // «каждый лишний блок глубины — ещё слой породы на всю длину дороги» —
    // неправда. Столбец выемки под клетку полотна всегда один и тот же:
    // «ВысотаТоннеляДороги» клеток над полотном плюс постель, сколько бы земли
    // ни лежало сверху. Выемка в 4 бл и в 12 бл стоят одинаково; глубже просто
    // остаётся кровля. Значит четвёрка не берегла ни одного удара киркой — она
    // только останавливала дорогу: 22.08 в 17:25:14 посильный спуск встал на
    // ВОСЬМОМ ряду из тридцати одного из-за обычного бугра в 4,5 бл.
    //
    // Ноль — «веди строго по земле». Очень большое число даст штольню вместо
    // дороги: кровлю бот держать не умеет, осыпающийся сверху песок разгребать
    // придётся. А главное — число больше не ловушка: весь ход разведывается ДО
    // первого удара, и не хватило предела — бот назовёт ряд, клетку и число,
    // которое надо сюда поставить, не тронув ни одного блока
    "ГлубинаВыемкиДороги": 12,

    // ВЫСОТА НАСЫПИ, блоков — сестра «ГлубинаВыемкиДороги»: та говорит,
    // насколько глубоко резать, когда полотно уходит ПОД землю, эта —
    // насколько высоко подсыпать, когда оно поднимается НАД ней.
    //
    // Раньше над провалом бот бросал НАСТИЛ (один слой блоков по оси, чтобы
    // перейти) и мостил поверх него полосу в три клетки: держалась средняя,
    // края висели в воздухе. Слова заказчика 23.08: «если не хватает блоков и
    // лестница висит в воздухе, то пусть достраивает землей основу и на ней
    // строит». Теперь подсыпает — снизу вверх, под каждую клетку ряда.
    //
    // Цена линейная: клетка насыпи — блок земли и удар, ряд шириной 3 при
    // глубине 3 стоит девять блоков. Глубокий провал дешевле ПЕРЕЙТИ мостом,
    // чем засыпать, — там мост и остаётся. Тройка же тут длина руки, а не
    // вкус: до дна насыпи в 3 бл от глаз ≈ 4,3 при досягаемости игры 4,5,
    // до дна четвёрки уже ≈ 5,3 — сервер такого клика не примет.
    //
    // Ноль — «не подсыпать вовсе», дорога останется на настиле
    "ВысотаНасыпиДороги": 3,

    "ПокрытиеДороги": "",
    "ПолублокДороги": "",
    "СперваВыкопатьПотомМостить": true,

    // МОСТИТЬ ЛИ ОГРЫЗОК, КОГДА ПРОХОДКА ВСТАЛА. Третья жалоба заказчика на
    // одно и то же, слова 19.08 дословно: «он всё ещё начинает в середине
    // стройки начинать мостить дорогу, а я просил в начале выкапывать, а потом
    // уже ставить блоки». В журнале 23:51:14 бот сам объявил «сперва прохожу
    // весь ход (39 рядов) и копаю его, потом возвращаюсь к началу и мощу» — и
    // тут же: «ПРОХОДКА ВСТАЛА на ряду 11 из 39 … кладу полотно только на
    // выкопанные 11 рядов». Формально честно, а на глаз — мощёный обрубок
    // посреди недокопанного хода.
    //
    // Выключено: встала проходка — не кладу НИ ОДНОГО блока полотна, встаю и
    // называю, где встал, почему и что повернуть. Выкопанное не пропадает:
    // уберите помеху (или поднимите «ГлубинаВыемкиДороги», если встало на ней)
    // — следующий заход докопает и замостит всё разом.
    //
    // Включают, когда полотно нужно хоть какое-нибудь прямо сейчас
    "МоститьНедокопанное": false,

    // МЕТАНИЯ МЕЖДУ ДОМОМ И СТРОЙКОЙ. Слова заказчика: «допустим дал ему задачу
    // дорогу делать, а он метался между домом и строительством, хотел что-то
    // сделать, возможно недостающие инструменты». Уводило его не задание и не
    // бой: покрытие кончалось ПОСРЕДИ РЯДА, дорога звала снабжение, а то честно
    // шло к сундукам дома. Бот приносил одну стопку, клал её, покрытие
    // кончалось снова — и он шёл снова. Потолка у таких рейсов не было никакого.
    //
    // Выключено: рейс за покрытием делается ОДИН раз, ДО первой положенной
    // клетки. Дальше бот доделывает тем, что сделает на месте по рецепту,
    // переходит на другое годное покрытие — а нет ни того ни другого, честно
    // встаёт и называет нехватку. Остаток домостит возврат или очередь задач:
    // у неё рейс за материалом делается МЕЖДУ заходами, и потолок есть там.
    //
    // Включают, когда дом в двух шагах от стройки. Цена — те самые метания
    "БегатьЗаПокрытиемПосредиДороги": false,

    // НЕПОСИЛЬНЫЙ УКЛОН. Полотно поднимается и опускается на ПОЛБЛОКА за ряд —
    // круче человек без прыжка не всходит. Живой случай 16.08: «дорога
    // (512067,112,512241) → (512030,80,512241)» — это 32 блока вниз на 38
    // рядов, а нужно их 65. Бот знал заранее, что не выберет, и всё равно
    // брался: десять заходов подряд вставал на первых рядах.
    //
    // Выключено — бот отказывается СРАЗУ, до первого удара, и называет числа:
    // докуда дойдёт по высоте и сколько рядов нужно на самом деле. Включают,
    // когда нужен спуск «сколько получится»
    "БратьсяЗаНепосильныйУклон": false,

    // ВРЕМЕННЫЕ ЛЕСА И СВЕРКА ПОСТРОЙКИ. Просьба заказчика дословно:
    // «разрешить строить временные леса во время стройки или копания объектов,
    // которые в конце убираем» и «надо проверять объекты потом на лишние блоки».
    //
    // Ставить столб и вешать лестницу бот умел и раньше — новое здесь ПАМЯТЬ о
    // поставленном и уборка ровно этого и только этого. Снимаются те блоки, что
    // бот ставил сам; недоубранное он называет вслух с координатами. Выключают
    // леса там, где нельзя оставить в мире ни одного своего блока даже на
    // минуту (караванщик на чужом сервере) — ценой того, что бот встанет там,
    // где вылез бы
    "СтроитьВременныеЛеса": true,
    "УбиратьЛесаПослеРаботы": true,

    // ЛУЧШЕ ПРОКОПАТЬ, ЧЕМ ЗАСТРОИТЬ. Слова заказчика дословно: «ставил леса
    // временные и сам застрял из-за них. Логичнее часто не их ставить, а просто
    // все прокапывать». Ниже этой глубины бот рубит себе лесенку в стене —
    // ничего не тратит и ничего не оставляет в мире; выше берётся за покупные
    // приёмы (лестница по стене, столб из сумки).
    //
    // Двенадцать, а не прежние три. Живой случай 16.08, 12:53:10: до верха семь
    // блоков, порог три — и бот, у которого в сумке лежали лестницы и три сотни
    // дорожного полотна, полез строить. Перекладина встала ему в клетку
    // собственных ног, столб после неё не вырос, три минуты ушли в круг. Тот же
    // подъём ступенями он взял за тридцать три секунды. Ноль — ступенями не
    // выходить вовсе (так спрашивает тот, кому нельзя портить стены вокруг)
    "ВыходитьСтупенямиДо": 12,

    // СКОЛЬКО СЕКУНД ПОМНИТЬ, ЧТО ОТСЮДА ТУДА НЕ ДОЙТИ. Живой случай 16.08,
    // 20:30:06–20:32:48: подбор целился в камень на дне ямы, движение честно
    // отвечало «не дойти», и через секунду его спрашивали о том же. За две с
    // половиной минуты — пятнадцать полных походов на ПЯТЬ разных клеток, 363
    // строки журнала и сорок пять раз подряд одно и то же «эту клетку отсюда я
    // уже не смог достать … с назад». Бот сам говорил «второй раз перебирать то
    // же самое незачем» — и шёл перебирать.
    //
    // Память забывается сама, стоит боту сдвинуться с места или миру
    // перемениться по факту от сервера, поэтому число маленькое: это защита от
    // повтора одного расчёта в одну секунду, а не приговор клетке. Ноль —
    // не помнить вовсе (поведение до этой правки)
    "ПомнитьОтказДорогиСекунд": 20,

    // Сверка идёт по уже прогруженным чанкам и стоит секунды, а находит то, что
    // человек иначе назовёт браком: куст, оставшийся в ходе дороги, столб,
    // забытый посреди ямы. Клетки, которых не видно, бот честно считает
    // НЕпроверенными, а не целыми. «СниматьЛишнихЗаСверку» — предел механизма:
    // сотня лишних блоков это уже вторая стройка, и узнать о ней надо числом
    "ПроверятьПостройкуПослеРаботы": true,
    "СниматьЛишнихЗаСверку": 64,
    // ПЛАНИРОВАТЬ НАПЕРЁД — ВКЛЮЧЕНО 23.08, И ЭТО ПЕРЕМЕНА, О КОТОРОЙ НАДО
    // ЗНАТЬ. Ручки этой не было НИ В ОДНОМ пресете, а умолчание у неё «нет» —
    // значит планировщик не запускался ни разу. Все прежние жалобы на
    // «револьвер» были жалобами на простую раскладку по весу: без сроков, без
    // созревания, без «дешёвое и скорое вперёд».
    //
    // Что даёт: вес становится КРИВОЙ (голод растёт со временем), а выбор идёт
    // по сочетанию «вес и сколько дело займёт». Бот доедает ПЕРЕД выходом и
    // говорит почему. Рефлексы жизни — возрождение, бой, не висеть в воздухе —
    // галочка не трогает.
    //
    // Откат в одну строку: поставьте false

    // ---------------- ЩИТ И ЛУК (волна 26.08) ----------------
    //
    // ЩИТ — НЕ БРОНЯ. В игре это обычный предмет в ЛЕВОЙ РУКЕ (storageFlags
    // 257 = General|Offhand, слот 11 хотбара) — в той самой, где живёт фонарь.
    // Значит фонарь и щит ДЕРУТСЯ за один слот, и спор решён явно: при угрозе
    // рука у щита, а перевернуть решение можно ручкой ниже.
    // Что даёт: грубый щит списывает 3 хп с удара и 3 со стрелы, черностражий
    // — 5,5 и 12, при полном запасе здоровья в 15. Чего стоит: скорости ноль
    // (в отличие от лат), но ЛЮБОЙ предмет в левой руке даёт +20 % расхода еды.
    // Шкала та же, что у брони: «Никогда», «ВБою», «ПокаРядомОпасно», «Всегда»
    "НоситьЩит": "ПокаРядомОпасно",

    // ПОДНЯТЬ ЩИТ — значит ЗАЖАТЬ ПРИСЕД, и это единственное, что в игре вообще
    // на что-то влияет (шанс перехвата 0,9 вместо 0,2; анимация поднятого щита
    // — косметика клиента). Цена: на присяде тело идёт 0,35 обычной скорости,
    // поэтому щит поднимается ровно на размен вплотную и опускается перед
    // отскоком и погоней
    "ПодниматьЩитВБою": true,

    // «В темноте с дрифтером что важнее?» Заводское — ЩИТ: угроза длится
    // десятки секунд, темнота часы, а фонарь от удара не спасает вовсе.
    // Поставьте true, если бот светит там, где мобов не бывает
    "ВТемнотеФонарьВажнееЩита": false,

    // ЛУК. Бот считает падение стрелы (на 20 бл она проседает 1,06 бл), берёт
    // упреждение по ЗАМЕРЕННОЙ скорости цели и НЕ СТРЕЛЯЕТ СКВОЗЬ СТЕНЫ.
    // ЧЕСТНО О ГЛАВНОМ: ОН БУДЕТ ПРОМАХИВАТЬСЯ. Разброс кидает сервер, и числа
    // эти боту видны — вычесть их и попадать всегда было бы читом, которого мы
    // не делаем
    "СтрелятьИзЛука": true,
    // Докуда есть смысл: на 20 бл конус полностью натянутого простого лука
    // ±0,7 бл (попадание), на 40 — ±1,3 бл (промах по идущей твари)
    "СтрелятьНеДальше": 20,
    // Ближе — сходиться: натяг стоит секунду, за неё волк проходит шесть блоков
    "СтрелятьНеБлижеЧем": 5,
    // НИЖНЯЯ ГРАНИЦА НАТЯГА. Меньше 0,41 с — выстрела НЕ БУДЕТ ВОВСЕ (сервер
    // считает secondsUsed как своё время между пакетами плюс 0,02 с за каждый
    // шаг тела, то есть t·1,6, а порог у него 0,65). Голому боту до потолка
    // точности хватает 0,54 с.
    // СВЕРХУ БОТ ДОТЯНЕТ САМ, если на нём броня: она режет скорость наводки
    // (три латных предмета — вдвое с лишним), и до потолка тогда нужно 1,31 с.
    // Об этом он говорит в журнал. Живьём 26.08 при 0,9 с одетый бот не
    // дотягивал НИКОГДА: конус 0,15 рад, доля попадания 0,056 на 12,9 бл
    "ТянутьТетивуСекунд": 0.9,
    // С КАКОЙ ДОЛИ ПОПАДАНИЯ БРАТЬСЯ СТРЕЛЯТЬ. Долю бот считает по конусу
    // разброса, дальности и КОРОБКЕ ЦЕЛИ из реестра сервера (дрифтер 0,6 бл
    // шириной, волк 1,2 — вдвое разный шанс с того же места). Ниже порога
    // выстрела не будет, и отказ назовёт числа и эту ручку.
    // КОПАТЕЛЮ КАЖДАЯ СТРЕЛА — ЭТО ХОДКА НАВЕРХ К КУЗНЕ, поэтому порог высокий:
    // по дрифтеру при ПОЛНОМ натяге доля 0,84 на 12,9 бл, 0,54 на 20 и 0,42 на
    // 24; в трёх латных предметах — 0,59, 0,31 и 0,21. Порог 0,45 держит выстрел
    // до ~21 бл налегке и до ~15 в латах, дальше — подходит и бьёт киркой
    // ЗАГНАННЫЙ В УГОЛ И БЕЗ БЛИЖНЕГО ОРУЖИЯ СТРЕЛЯЕТ С ЛЮБЫМ ШАНСОМ: порог
    // снимается сам, иначе бот умирал бы «по расчёту» с натянутой тетивой
    "СтрелятьПриШансеНеНиже": 0.45,

    // С КАКОГО РАССТОЯНИЯ ВРАГ СЧИТАЕТСЯ НАПАДАЮЩИМ — то есть когда бот сам
    // берётся за оружие, ещё не получив удара, И НЕТ ЛУКА ИЛИ СТРЕЛ.
    // Четыре блока меньше, чем «СтрелятьНеБлижеЧем» (5), и до 26.08 это значило,
    // что лук в обычной обороне не спрашивается вовсе: к тому мигу, как враг
    // выбран, он уже ближе, чем позволено стрелять. Теперь этот спор решён —
    // см. ручку «ВстречатьЛукомИздалека» ниже; здесь осталось «на сколько шагов
    // отойти от своего дела ради драки РУКАМИ». Больше — бот начинает больше
    // драк, и это решение ваше, а не наше. До 26.08 числа здесь не было ни в
    // одном пресете: оно стояло жёстко в коде трёх ролей
    "ВступатьВБойСРасстояния": 4,

    // РАДИУС МЕСТИ: получив НАСТОЯЩИЙ удар, бот отвечает обидчику и в этом
    // радиусе, а не только в «ВступатьВБойСРасстояния». Это и есть та честная
    // дверь, через которую лук достаётся в обороне: ответить с двадцати блоков
    // можно, а начинать драку с двадцати — нет.
    // ДО 27.08 ЧИСЛА ЗДЕСЬ НЕ БЫЛО НИ В ОДНОМ ПРЕСЕТЕ, а бот в журнале называл
    // ручку «ОтвечатьНаУронРадиус», которой в проекте нет вовсе: заказчик шёл
    // её крутить и не находил.
    "РадиусМести": 30,

    // ВСТРЕЧАТЬ ЛУКОМ ИЗДАЛЕКА, А НЕ ПОДПУСКАТЬ ВПЛОТНУЮ.
    // Заказчик дословно: «на дальних мобов снова не агрится, просто броню
    // надевает, а нужно интеллектуально: если есть лук — логично расстрелять».
    // Пока лук и стрелы при себе, врага берут в бой с «СтрелятьНеДальше» и
    // расстреливают, пока он идёт. Кончились стрелы или нет лука — круг сразу
    // возвращается к «ВступатьВБойСРасстояния», и бот сходится ногами, как
    // сходился всегда (второго способа бить дальних не заведено).
    // СНИМАЮТ ТАМ, где стрелы дороги или лишний шум не нужен: бот перестанет
    // начинать дальние стычки и будет вести себя как до 26.08
    "ВстречатьЛукомИздалека": true,

    // ЗОВУЩИХ ПОДМОГУ БИТЬ ИЗДАЛИ, НЕ ПОДХОДЯ. Заказчик: «луком предпочтительно,
    // если есть, с далека убивать колокола».
    // ПОЧЕМУ ИЗДАЛИ — это факт из самой игры, а не осторожность: у колокола
    // СВОЕГО УДАРА НЕТ ВОВСЕ (в его задачах нет ни meleeattack, ни seekentity),
    // зато на шум рядом он каждые 1…5 с зовёт до ШЕСТИ глубинных тварей в
    // двенадцать блоков вокруг (drifter-deep, drifter-tainted, drifter-corrupt,
    // shiver-deep, bowtorn-deep, locust-corrupt). Подойти и махать мечом —
    // значит драться со всеми, кого он позовёт за те полминуты, что с него
    // сходят сто хп.
    // КОГО СЧИТАТЬ ТАКИМ, решает РЕЕСТР СЕРВЕРА: спрашивается класс сущности
    // («EntityBell» — класс самой игры под сирену тревоги), а не список имён.
    // Без лука ручка молчит: держаться поодаль, не имея чем бить оттуда, — это
    // «стою и смотрю», а не бой
    "ЗовущихПодмогуБитьИздали": true,

    // ДРАТЬСЯ ТОЛЬКО С ТЕМИ, КТО ДО МЕНЯ ДОЙДЁТ.
    //
    // Заказчик: «не имеет смысл агриться на врагов за стенами дома, если двери
    // закрыты». Раньше «что между нами» мерил один ЛУЧ, а сквозь окно луч
    // проходит: тварь видно, преграды нет — и бот бросал дело, надевал броню
    // («42 % скорости и 72 % лишнего голода») и лез к ней. Это и есть «бежит в
    // окно и дерётся попой» из живого журнала.
    //
    // Теперь бот ОБВОДИТ ВОЗДУХ ВОКРУГ СЕБЯ, пока тот не упрётся в стены и
    // закрытые двери. Замкнулось — значит внутрь хода нет НИКОМУ: ни ходящему,
    // ни лезущему по стене, ни летящему, потому что сквозь блок не проходит
    // никто, а ломать блоки и открывать двери ванильные твари не умеют (все
    // задачи ИИ игры 1.22.7 разобраны поимённо, см. CreatureReach).
    //
    // ЗДЕСЬ СТОЯЛ ПОИСК ПУТИ ЗА ТВАРЬ, И ОН НЕ РАБОТАЛ. Его глушила застава
    // «он ниже меня — судить его моим поиском нельзя», а НИЖЕ игрока (1,85) в
    // игре ВСЕ: дрифтер 1,3, шивер 1,0, волк 1,0, локуст 0,6. И второе: поиск
    // шёл от твари, то есть с открытой стороны стены, и в чистом поле съедал
    // потолок клеток раньше, чем успевал что-то доказать.
    //
    // ЧЕГО ЭТО НЕ ЗАПРЕЩАЕТ: ответа на удар — ударил, значит дошёл, и бой идёт
    // со всеми числами. А вот выстрел из окна разрешает ОТДЕЛЬНАЯ ручка ниже,
    // и заводское значение у неё «нет».
    //
    // ГДЕ МЕРКА ОШИБАЕТСЯ, И ВСЕГДА В СТОРОНУ «ДОЙДЁТ»: двор без крыши запертым
    // не считается (воздух над ним уходит в небо), непришедший кусок мира — не
    // стена, а открытую дверь тварь пройдёт.
    // КОПАТЕЛЮ ЭТО ГЛАВНОЕ: жалоба «стоит афк в карьере» пришла именно отсюда —
    // работу обрывала тварь, которой до бота было не добраться.
    "ДратьсяСТемиКтоДоМеняДойдёт": true,

    // СТРЕЛЯТЬ ЛИ В ТОГО, КОМУ ДО МЕНЯ НЕ ДОЙТИ. Ручка соседняя, а решает
    // другое: та запрещает ХОДИТЬ к запертому снаружи врагу, эта — стрелять по
    // нему из окна.
    //
    // ПОЧЕМУ ЭТО ВАЖНО, ЧИСЛАМИ. У боя с недостижимым врагом цена ноль (размена
    // не будет), значит оценка сто. У «занимаюсь своим» при той же обстановке
    // тоже сто. При равных оценках побеждает первая по порядку — ДРАКА. То есть
    // бот с луком бросал работу и обстреливал каждого видимого в окно дрифтера,
    // хотя жалоба была ровно обратная: «не имеет смысл агриться на врагов за
    // стенами дома, если двери закрыты».
    //
    // ЦЕНА «ДА»: бот бросает дело ради каждого, кого видит и достаёт стрелой, и
    // тратит на него стрелы. Сквозь БЛОКИ он не стреляет ни при каком значении —
    // там своя мерка, луч, и лук отказывается сам.
    // КОПАТЕЛЮ НЕТ: его работа в яме, и каждый выстрел через окно — это
    // брошенный карьер. Ровно на этом заказчик и написал «стоит афк в карьере».
    "СтрелятьВТехКтоДоМеняНеДойдёт": false,

    // СКОЛЬКО КЛЕТОК ВОЗДУХА ОБОЙТИ, РЕШАЯ «ЗАПЕРТ ЛИ Я».
    //
    // Воздух замкнулся стенами — бот отвечает «снаружи мне не опасен» и
    // занимается своим. Не замкнулся за это число клеток — ответ «не знаю», и
    // бот считает врага опасным. Значит числом двигается граница между «не
    // связываюсь» и «дерусь», а не одна скорость.
    //
    // ЦЕНА ЗДЕСЬ МАЛЕНЬКАЯ, И ЭТО ГЛАВНАЯ РАЗНИЦА С ПРЕЖНЕЙ МЕРКОЙ. Раньше тут
    // стоял поиск пути за тварь, и один исчерпанный потолок в 8000 клеток стоил
    // около 0,7 с — НА КАЖДОГО врага. Обход воздуха — это те же 8000 вопросов
    // «сплошная ли клетка», доли миллисекунды, и он ОДИН на всех сразу: стены
    // вокруг меня не зависят от того, кто стоит снаружи.
    //
    // Меньше сотни ставить нельзя: воздух не замкнётся даже в комнате, ответом
    // станет вечное «не знаю», и бот будет драться со всеми, как до 28.08.
    "СколькоКлетокСмотретьПроЗапертоеМесто": 8000,

    "ПланироватьНаперёд": true,

    // ======================================================================
    // ОСТАЛЬНЫЕ РУЧКИ ЭТОЙ РОЛИ — НАЗВАНЫ ВСЛУХ, СО СВОИМИ ЗАВОДСКИМИ.
    //
    // ПОЧЕМУ ОНИ ЗДЕСЬ ПОЯВИЛИСЬ. Ручка, которой нет в этом файле, для
    // хозяина бота НЕ СУЩЕСТВУЕТ: пресет — это то, что читают и правят
    // руками, и жалоба «не нашёл настройку где указывается…» звучала уже
    // дважды про ручки, которые всё это время работали. До правки в этом
    // файле стояло 93 из 127 общих ручек роли и не хватало ещё 18 своих;
    // остальные бот применял всё равно — молча, своими заводскими.
    //
    // ЗНАЧЕНИЯ ЗДЕСЬ — ЗАВОДСКИЕ ЭТОЙ РОЛИ, и это НЕ «одно на всех»:
    // заводское назначает сама роль, и оно у ролей разное (у Стражника
    // «ДержатьЛестниц» 0, у Выживальщика 64 — одна и та же ручка). Поэтому
    // появление этих строк НЕ МЕНЯЕТ поведения ни на шаг: отсутствие строки
    // и строка с заводским значением — для бота одно и то же. Строки,
    // стоящие ВЫШЕ, выбраны для этого пресета нарочно, их не трогали.
    // ======================================================================

    // ---- работа (раздел окна «Работа») ----

    // Сколько раз подряд возвращаться к работе, которую сбивают ВПУСТУЮ. 0
    // — не возвращаться вовсе.
    "ВозвращатьсяКПрерванному": 3,

    // Сколько секунд заход должен продержаться, чтобы считаться не пустым.
    "ЗачётЗаходаСекунд": 20,

    // Пауза перед возвратом, секунд: не отбирать тело у рефлекса на
    // полудороге.
    "ПаузаПередВозвратом": 1,

    // Сколько ждать освобождения тела, прежде чем честно отказаться,
    // секунд.
    "ЖдатьТелаСекунд": 180,

    // СКОЛЬКО ЖДАТЬ, ПРЕЖДЕ ЧЕМ ВЗЯТЬСЯ ЗАНОВО, КОГДА РАБОТУ ОСТАНОВИЛ МИР:
    // игрок встал на клетку, тварь пробежала, чанк не доехал. 0 — пробовать
    // сразу. Просьба заказчика 01.09, дословно: «если мешает игрок, то
    // пробовать заново, а не сбрасывать и вообще на все бы задачи так».
    // Сколько РАЗ браться заново — ручка «ВозвращатьсяКПрерванному» выше:
    // вопрос один, и двум числам на него разъехаться нельзя.
    "ЖдатьПеременыМираСекунд": 5,

    // СКОЛЬКО РАЗ ЗА ОДИН ПОХОД СТЕРПЕТЬ, ЧТО ХОДЬБУ ЗАБРАЛ ДРУГОЙ.
    // Перехват сам по себе законен: рефлекс выживания и приказ человека
    // обязаны перебивать фоновую дорогу.
    "СтерпетьПерехватовХодьбы": 2,

    // Насколько далеко искать место, чтобы сойти с клетки, которую сейчас
    // мостим, блоков. На своей клетке полотно не положишь — под ногами
    // тело.
    "ОтходитьСПолотнаНеДальше": 4,

    // Сколько мест перепробовать, сходя с полотна.
    "ПопытокСойтиСПолотна": 6,

    // Сколько секунд отводится на один шаг в сторону с полотна.
    "СекундНаШагВСторону": 6,

    // ---- руда (раздел окна «Поиск руды») ----

    // ЧЕРЕЗ СКОЛЬКО КЛЕТОК ХОДА ОГЛЯДЫВАТЬСЯ. Разведка смотрит на стены не
    // всю дорогу, а рывками: прошёл столько-то клеток — осмотрелся.
    "ОсматриватьсяЧерезКлеток": 6,

    // ОСТАНАВЛИВАТЬСЯ НА ПЕРВОЙ ЖЕ ПОДХОДЯЩЕЙ НАХОДКЕ. ПОЧЕМУ ЭТО ПОЛИТИКА.
    // Наряду «принеси 20 меди» первой жилы хватает — дальше копать не надо,
    // надо брать и нести.
    "ОстанавливатьсяНаПервойНаходке": true,

    // СКОЛЬКО КЛЕТОК ЧУЖОГО МЕТАЛЛА ЗАПОМИНАТЬ ЗА ОДИН ОСМОТР, на каждый
    // вид.
    "ПомнитьЧужойРудыКлеток": 3,

    // ---- склад (раздел окна «Дом и склад») ----

    // Брать под склад СОСЕДНИЕ сундуки в этом радиусе от заданной точки,
    // блоков. 0 — только сама точка.
    "СоседниеСундукиВРадиусе": 6,

    // ПРИ СКОЛЬКИХ СВОБОДНЫХ МЕСТАХ ПОРА НА СКЛАД. 0 — только когда сумка
    // забита начисто. Порог общий на весь бот: по нему же ходит на склад
    // наряд за рудой.
    "РазгружатьсяПриСвободныхМестах": 3,

    // Через сколько секунд пробовать снова, если рейс не удался: сундук
    // полон, до склада не дойти, в заданной точке не хранилище.
    "ПовторРазгрузкиЧерезСекунд": 60,

    // СКОЛЬКО СЕКУНД ОТВОДИТСЯ НА ВЕСЬ РЕЙС: дойти, сложить, осмотреть
    // склад и вернуться. Не уложился — рейс кончается честным отчётом, а не
    // висит.
    "СекундНаРейс": 300,

    // ДАЛЬШЕ ЭТОГО СКЛАДА НЕ БЫВАЕТ, блоков.
    "СкладНеДальшеЧем": 1000,

    // ВОЗВРАЩАТЬСЯ ТУДА, ОТКУДА УШЁЛ (в забой, к прилавку). Выключить — бот
    // останется у сундука и возьмётся за то, что важнее прямо там.
    "ВозвращатьсяВЗабой": true,

    // ---- безопасность (раздел окна «Безопасность») ----

    // НАСКОЛЬКО МОЖНО ОТОЙТИ ОТ МЕСТА, ГДЕ СПРЯТАЛСЯ, и всё ещё считаться
    // спрятавшимся, блоков. Укрытие бот держит двумя приёмами, и второй —
    // своя закрытая дверь.
    "УкрытиеДержитсяВРадиусе": 6,

    // НАСКОЛЬКО РЕЖЕ ПОВТОРЯТЬ ОДНУ И ТУ ЖЕ НОВОСТЬ ПРО РАЗЛОМЫ, секунд. 0
    // — не глушить вовсе (на разбор живого журнала).
    "ПовторыПроРазломыРежеСекунд": 300,

    // ЦЕНА УХОДА, хп: во сколько ЛИШНЕГО здоровья бот оценивает сам факт
    // бегства — брошенное дело, потерянное место и то, что тварь всё равно
    // встретится снова.
    "ЦенаУхода": 8,

    // ЦЕНА ЗАКЛАДЫВАНИЯ, хп: во сколько лишнего здоровья бот оценивает то,
    // что закроется блоком.
    "ЦенаЗакладывания": 12,

    // НИЖЕ КАКОЙ ДОЛИ ЗДОРОВЬЯ БОТ СЧИТАЕТ БОЙ ПРОИГРАННЫМ и отступает: 0,5
    // — половина. Размен ударов ниже этой черты запрещён, чем бы он ни
    // считался по числам.
    "ОтступатьНижеЗдоровья": 0.5,

    // ДО КАКОЙ ДОЛИ ЗДОРОВЬЯ ОТЛЕЖАТЬСЯ, чтобы снова принимать бой.
    "ВозвращатьсяВБойПри": 0.8,

    // ЧТО ДЕЛАТЬ С ТЕМ, КТО УДАРИЛ И ДЕРЖИТСЯ ПООДАЛЬ: «Никогда» — не
    // мстить вовсе, «Рядом» — ответить, если он рядом, но не гнаться,
    // «Догонять» — догнать и наказать. Выбор: Никогда, Рядом, Догонять.
    "Мстить": "Догонять",

    // НИЖЕ КАКОЙ ДОЛИ СЫТОСТИ БРОСАТЬ ПОГОНЮ И ИДТИ ЕСТЬ: 0,25 — четверть.
    // Гнаться за обидчиком, когда сам умираешь, — плохая идея.
    "БроситьПогонюПриСытостиНиже": 0.25,

    // НА СКОЛЬКО БЛОКОВ СЧИТАТЬ, ЧТО ОТОРВАЛСЯ.
    "ОтрыватьсяНеБлижеЧемНа": 6,

    // Ниже какой стабильности уходить: 0,2 — это те самые «двадцать
    // процентов». Ноль — не уходить никогда (то же, что выключить ручку
    // выше).
    "УходитьПриСтабильностиНиже": 0.2,

    // До какой стабильности считать, что обошлось, и возвращаться к делам.
    "СтабильностьОтпускаетНа": 0.4,

    // Как далеко вокруг искать место повыше, блоков. Больше — дольше дорога
    // и дольше поиск; в шахте больше 32 обычно бесполезно.
    "ЗаСтабильностьюНеДальше": 24,

    // НАСКОЛЬКО ДАЛЕКО ЗАГЛЯДЫВАТЬ ВПЕРЁД, секунд. Действует только при
    // включённом «ПланироватьНаперёд»: дальше этого срока бот не спрашивает
    // «что созреет, пока я занят».
    "ГоризонтПланированияСекунд": 300,

    // ВЫДЕРЖКА НАЧАТОГО ДЕЛА, секунд: столько свежий хозяин тела держит его от
    // тех, кто просто важнее. Живая жалоба 30.08: «он бегал вперед назад с
    // резкими разворотами как сумасшедший» — шесть смен хозяина тела за
    // четырнадцать секунд, и работы за них «дорога 0 рядов из 21». Каждый
    // выбор был верен, неверна была череда: у смены хозяина есть цена —
    // разворот на месте и марш к новой цели.
    //
    // ЭТИ ЖЕ СЕКУНДЫ ДЕРЖАТ ТЕЛО ЗА ПЕРЕБИТЫМ ДЕЛОМ, ПОКА ОНО ВОЗВРАЩАЕТСЯ.
    // Между заходами тело формально ничьё, и в эту щель в том же журнале
    // влезали сборы («снарядиться» — они же накрафтили 24 лестницы, которые
    // дорога не могла ни положить под ноги, ни сдать на склад) и подбор своей
    // добычи; вернувшаяся дорога отбирала тело обратно — ещё один разворот.
    //
    // НЕ ЗАДЕРЖИВАЕТ НИ ПРИ КАКОМ ЧИСЛЕ: еду, лечение, выход из огня и воды,
    // смерть, «стоп» и новый приказ человека, а ещё удар (избитый бот получает
    // тело в ту же секунду, отдельной дверью). Ноль — как было: перехват сразу.
    "ВыдержкаНачатогоДелаСекунд": 5,

    // ---- снаряжение (раздел окна «Снаряжение») ----

    // ЧТО НЕ СДАВАТЬ НА СКЛАД — куски кодов через запятую («pickaxe,
    // shovel, axe, torch»). Пусто — по названию не оставлять ничего.
    "ОставлятьПриСебе": "pickaxe, shovel, axe, torch",

    // Оставлять при себе всё, у чего есть ПРОЧНОСТЬ: инструменты и оружие.
    // Так узнаётся и модовый молот, которого нет ни в одном списке масок.
    "ОставлятьВсеИнструменты": true,

    // Оставлять при себе еду.
    "ОставлятьЕду": true,

    // ---- путь (раздел окна «Путь и препятствия») ----

    // Достраивать столб, чтобы подняться к позвавшему, если дороги наверх
    // нет.
    "СтолбитьсяКГостю": true,

    // Насколько высокий столб бот согласен построить за раз, блоков.
    "МаксимальныйСтолб": 24,

    // Насколько близко к цели по горизонтали имеет смысл строить вертикаль —
    // и вверх, и вниз, блоков. Дальше это уже не подъём к цели, а башня
    // посреди поля (и не спуск к цели, а колодец посреди поля).
    "СтолбитьсяВРадиусе": 20,

    // Слезать, разбирая под собой то, по чему поднялся. Выключишь — бот и
    // наверх не полезет: подъём без спуска это ловушка, и он честно скажет
    // «наверх поднимусь, а слезть будет нечем — не лезу».
    "СлезатьРазбираяПодСобой": true,

    // Предел самого механизма спуска за один заход, блоков.
    "ПределСпускаСтройки": 32,

    // Спрашивать про воду ПЕРЕД прямым ходом.
    "СмотретьВодуПередПрямымХодом": true,

    // Во сколько секунд обходится одна ступень лесенки.
    "СекундНаСтупень": 6,

    // ---- опись (раздел окна «Опись склада») ----

    // СКОЛЬКО МИНУТ ЗАПИСЬ СЧИТАЕТСЯ СВЕЖЕЙ.
    "ОписьСвежаМинут": 5,

    // ЧЕРЕЗ СКОЛЬКО МИНУТ ОТВЕТ «ЭТОГО ТАМ НЕТ» ПЕРЕСТАЁТ БЫТЬ ОТВЕТОМ.
    "ОписьПротухаетЧерезМинут": 30,

    // СКОЛЬКО СЕКУНД ОТВОДИТСЯ НА ОБХОД СКЛАДА. Потолок нужен затем, что
    // без него опись съедала бы тот самый рейс, ради которого бот и пришёл.
    "СекундНаОбходСклада": 60,

    // ---- очередь (раздел окна «Очередь задач») ----

    // СКОЛЬКО СЕКУНД ДАВАТЬ НА ДОРОГУ К ТОЧКЕ ЗАДАЧИ. Не дошёл за это время
    // — задача честно кончается словами «до точки работы не дошёл», а не
    // стоит всю ночь.
    "СекундНаДорогуКЗадаче": 300,

    // СКОЛЬКО РАЗ ЗА ОДНУ ЗАДАЧУ ОТЛУЧАТЬСЯ ДОМОЙ.
    "РейсовДомойЗаЗадачу": 2,

    // НА СКОЛЬКО СБОРОВ РЕЦЕПТА БРАТЬ МАТЕРИАЛ ЗА ОДИН РЕЙС.
    "БратьМатериалНаСборов": 8,

    // ДАЛЬШЕ ЭТОГО ЗА МАТЕРИАЛОМ НЕ ХОДИТЬ, блоков. 0 — порога нет. ЗАКАЗ
    // 15.08: «порог „стоит ли идти“ (далеко ли, много ли времени) —
    // настройкой роли».
    "ЗаМатериаломНеДальшеБлоков": 0,

    // И НЕ ДОЛЬШЕ ЭТОГО — минут на дорогу туда-обратно. 0 — порога нет.
    "ЗаМатериаломНеДольшеМинут": 0,

    // ---- транслокаторы (раздел окна «Транслокаторы») ----

    // ФАЙЛ СЕТИ РЯДОМ С БОТОМ (он же кеш скачанного). Пусто — файлом не
    // пользоваться.
    "ФайлСетиТранслокаторов": "",

    // ЧЕРЕЗ СКОЛЬКО ЧАСОВ ИДТИ ЗА КАРТОЙ ЗАНОВО. По умолчанию сутки —
    // столько же, сколько живёт сама выгрузка (WebCartographer
    // перевыгружает мир не чаще раза в день).
    "КартаУстареваетЧерезЧасов": 24,

    // НА СКОЛЬКО БЛОКОВ БОТ ГОТОВ ОТОЙТИ ОТ СЕТИ ПЕШКОМ, чтобы попасть на
    // ближайший транслокатор (и так же — с последнего до цели).
    "ОтходитьОтСетиНеДальше": 3000,

    // ВО СКОЛЬКО СЕКУНД ОБХОДИТСЯ ОДНА ПЕРЕСАДКА — от «встал на пластину»
    // до «стою на той стороне».
    "СекундНаПересадку": 10,

    // СКОЛЬКО СЕКУНД НА БЛОК ПУТИ ПО ЗЕМЛЕ.
    "СекундНаБлокПешком": 0.22,

    // КОГДА СЕТЬ ТОГО СТОИТ: сколько секунд она должна выигрывать НА КАЖДОЙ
    // ПЕРЕСАДКЕ, чтобы бот шёл через неё, а не ногами.
    "ВыигрышНаПересадкуСекунд": 15,

    // С КАКОЙ ДАЛЬНОСТИ ВООБЩЕ ИСКАТЬ ТРАНСЛОКАТОР, блоков по прямой. 0 — не
    // искать никогда, ходить только ногами. Жалоба заказчика 01.09: «мы же
    // записываем в нашу постоянную память пары тл? а то бот побежал вместо тл»
    // — до этой ручки на сеть смотрел только щелчок по карте в окне.
    "ИскатьТранслокаторОтБлоков": 300,
}
}
