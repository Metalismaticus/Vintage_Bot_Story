    // восемнадцати соседей ради одного целого камня.
    //
    // Три — это грань, её ОСЫПАНИЕ и ПРОКОП к замурованному соседу. Осыпание
    // не выдумано: у гравия и песка висит UnstableFalling с
    // fallSidewaysChance 0.75 — падая, они с вероятностью три четверти
    // сваливаются в соседнюю клетку и засыпают освобождённую грань.
    //
    // Дорожите миром вокруг — ставьте 1: снесут не больше шести, но на
    // осыпающейся породе целого блока часто не выйдет вовсе, и бот назовёт
    // клетку, грань и число отработанных кругов, а не смолчит. Ниже единицы
    // не опускается: нулём заходов не освободить ни одной грани.
    "ЗаходовНаГраньОбкапывая": 3,

    // КОПАТЬ ШАХМАТКОЙ — «ЧЕРЕЗ ОДНУ», РАДИ ЦЕЛЫХ БЛОКОВ ВМЕСТО ЩЕБНЯ.
    //
    // Это ПОРЯДОК, а не выбор: ни одна клетка из работы не выпадает и ни один
    // лишний блок не ломается. Сперва снимаются «жертвы» — клетки одной
    // чётности и каждый второй поперечный слой, — а у остальных к их очереди
    // не остаётся НИ ОДНОЙ твёрдой грани. Игра при шести свободных гранях
    // отдаёт РОВНО ОДИН ЦЕЛЫЙ БЛОК вместо двух-трёх кусков щебня
    // (поведение BreakIfFloating, assets/survival/blocktypes/stone/rock.json).
    //
    // Ручка стоит У САМОГО УДАРА, поэтому её видит каждый, кто снимает породу,
    // а не каждая работа по отдельности. У карьера есть ещё и своя
    // «РовнаяЯмаЦеликом», но она про ВИД ямы, а эта про порядок: выключите
    // любую из двух — шахматки в яме не будет.
    //
    // Цена — ВРЕМЯ, а не блоки: ударов столько же, но по выработке приходится
    // пройти дважды (сперва за жертвами, потом за целыми). Нужна просто яма —
    // выключайте.
    //
    // КОГО ЭТО КАСАЕТСЯ — СПИСКОМ: ЯМА КАРЬЕРА И ОКАПЫВАНИЕ ЖИЛЫ. Обе снимают
    // ОБЪЁМ, то есть тело с толщиной по всем трём осям, а целый блок бывает
    // только там: у клетки должны освободиться ВСЕ ШЕСТЬ граней, значит каждый
    // сосед обязан либо быть воздухом, либо уйти вместе с ней.
    //
    // ДОРОГА, ШТОЛЬНЯ И УКРЫТИЕ ЦЕЛЫХ БЛОКОВ НЕ ДАЮТ НИ ОДНОГО, и это не
    // недоработка. Они снимают породу СРЕЗАМИ — ряд дороги, шаг хода, одна-две
    // клетки стены, — а у среза сосед ВПЕРЁД в заход не входит и стоит
    // нетронутой породой; одной твёрдой грани хватает, чтобы блок рассыпался
    // щебнем. Числа: ход 3×3×8 = 72 клетки объёмом даёт 3 целых, он же
    // срезами, как его копают живьём, — НОЛЬ.
    //
    // Здесь стояло «хотите целые блоки с дороги или хода — ставьте им ширину
    // от 3». Это была неправда: поставивший тройку вынимал втрое больше
    // породы и не получал ни одного целого блока, а у штольни ширины нет
    // вовсе — только «ВысотаШтольни».
    "ШахматкойРадиЦельныхБлоков": true,

    // Оставлять при себе всё, у чего есть ПРОЧНОСТЬ: инструменты и оружие.
    // Так узнаётся и модовый молот, которого нет ни в одном списке масок.
    "ОставлятьВсеИнструменты": true,

    // Оставлять при себе еду.
    "ОставлятьЕду": true,

    // Класть свет в ЛЕВУЮ руку, чтобы правая осталась под инструмент.
    // Выключить — свет поедет в правую и будет уступать кирке и оружию.
    "ФонарьВЛевойРуке": true,

    // Вернуть фонарь в сумку, когда рассвело или когда факел прогорел.
    "УбиратьФонарьДнём": true,

    // НОСИТЬ ФОНАРЬ И В ПЕЩЕРЕ, а не только ночью. Заказчик дословно:
    // «Фонарь нужно использовать ночью и в пещерах (но сделай доп
    // настройкой)».
    "ФонарьВПещере": true,

    // С КАКОЙ ГЛУБИНЫ ПОД ПОВЕРХНОСТЬЮ ЭТО УЖЕ ПЕЩЕРА, блоков.
    "ПещераГлубжеБлоков": 6,

    // ПОВЕРХНОСТЬ — ЭТО НЕ ГЛУБЖЕ СКОЛЬКИХ БЛОКОВ ПОД НЕБОМ. Пара к
    // «ПещераГлубжеБлоков»: под землю бот уходит на одной глубине, а
    // выходит обратно — на другой, поменьше.
    "ПоверхностьНеГлубжеБлоков": 3,

    // УБИРАТЬ ФОНАРЬ, КОГДА СВЕТ ПОДНЯЛСЯ ДО ЭТОГО УРОВНЯ (0…32, как в
    // самой игре).
    "ФонарьУбиратьПриСветеОт": 10,

    // ПОСЛЕ РАССВЕТА ДЕРЖАТЬ ФОНАРЬ ЕЩЁ, игровых часов (и настолько же
    // раньше брать его к ночи). Третий запас — по времени суток.
    "ДержатьФонарьПослеРассветаЧасов": 1,

    // НЕ ПЕРЕИГРЫВАТЬ РЕШЕНИЕ О ФОНАРЕ ЧАЩЕ, чем раз в столько секунд —
    // последний запас, уже не по числу, а по времени.
    "НеТрогатьФонарьСекунд": 20,

    // Выбрасывать землю и породу, когда место кончилось везде.
    "ВыбрасыватьЛишнее": true,

    // Ради еды выбрасывать даже при выключенном «ВыбрасыватьЛишнее».
    "ВыбрасыватьРадиЕды": true,

    // Что не выбрасывать никогда: куски кодов через запятую («clay,
    // flint»). Пусто — доверять мерке игры целиком.
    "НеВыбрасывать": "",

    // ---- путь (раздел окна «Путь и препятствия») ----
    //
    // РАЗДЕЛА ЭТОГО У ИИ НЕ БЫЛО ВОВСЕ, И ЗДЕСЬ ЭТО ДОРОЖЕ, ЧЕМ У ОСТАЛЬНЫХ.
    // Двадцать три ручки про подъёмы, обрывы, мосты, присед и воду на дороге жили
    // у одного Выживальщика — а ИИ ходит СВОИМИ УМЕНИЯМИ: нейросеть зовёт «goto»,
    // «climb_to», «descend_to» теми же руками, что человек в чате, и упирается в
    // те же кочки. Пока ручек тут не было, все эти числа доставались ей молча, из
    // библиотеки, и повернуть их было нечем: ни в окне, ни в этом файле.
    //
    // ВСЕ ДВАДЦАТЬ ТРИ У ИИ РАБОТАЮТ, И ВСЕ СТОЯТ ЗАВОДСКИМИ. Ни одного «нет»,
    // как у стражника и продавца: те стерегут чужую постройку, а ИИ отправляют
    // делать дело в незнакомом месте, и запертый бот, которому нечем выбраться,
    // стоит дороже испорченного потолка. Что при этом можно ломать, решает не
    // этот раздел, а застава построек и «ЛоматьЧужоеРадиВыхода»: false выше.
    //
    // ОДНО ЧИСЛО ЗДЕСЬ ВПРАВДУ МЕНЯЕТ ПОВЕДЕНИЕ, И ОБ ЭТОМ СКАЗАНО ВСЛУХ —
    // «ВыходитьСтупенямиДо» (внизу раздела). Прочие двадцать два совпадают с тем,
    // что бот и так брал из библиотеки: строка с заводским значением и её
    // отсутствие для бота одно и то же.

    // ПРОБИВАТЬСЯ ЛИ НАВЕРХ, КОГДА ДОРОГИ НЕТ: ступени, лестница, столб.
    // ЗАВОДСКОЕ — ДА, и для ИИ это главное «да» раздела. Нейросеть посылает бота
    // в места, которых сама не видела; яма, в которую он спустился за рудой или
    // упал с обрыва, без этой ручки становится концом смены — а стоит смена
    // денег, пока модель думает.
    // ЧЕГО ЭТО НЕ РАЗРЕШАЕТ: ломать чужое. Стены домов и склады бережёт застава
    // построек и «ЛоматьЧужоеРадиВыхода»: false — эта ручка про «браться ли», а
    // не про «что можно тронуть».
    "ВыбиратьсяНаверх": true,

    // СКОЛЬКО РАЗ ЗА ОДИН ПОХОД БРАТЬСЯ ВЫБИРАТЬСЯ НАВЕРХ. Без предела бот
    // ковырял бы потолок до утра; с ним он после четырёх заходов честно говорит,
    // что заперт, — а ИИ это слово читает и может придумать другой ход
    // (позвать хозяина, пойти в другую сторону), чего молчащий бот не даёт.
    "ПопытокПодъёма": 4,

    // НА СКОЛЬКО БЛОКОВ ВВЕРХ ПРОБИВАТЬСЯ, когда дороги нет вовсе. Это же число —
    // дальность взгляда: выше него бот кромки над собой не ищет и говорит
    // «кромки в 24 бл над собой не вижу».
    "ПробиватьсяВверхДо": 24,

    // ДОБЫВАТЬ ЛИ МАТЕРИАЛ НА СТОЛБ ВОКРУГ СЕБЯ, когда ставить нечего.
    // ЗАВОДСКОЕ — ДА: без этого «выберусь столбом» упирается в пустые сумки, а у
    // бота под управлением нейросети сумки пустеют внезапно — она тратит их на
    // то, что придумала минуту назад, и о запасе блоков не помнит.
    "ДобыватьМатериалНаСтолб": true,

    // НА СКОЛЬКО БЛОКОВ ВОКРУГ ИСКАТЬ СТЕНУ, к которой идти со дна широкой ямы.
    // Столб посреди карьера выводит на верх палки 1×1, откуда не слезть, — потому
    // сперва к стене. Шестнадцать блоков — это осмотр 1089 клеток, и зовётся он
    // только тогда, когда бот уже застрял, а не на каждом шагу.
    // Ноль — не искать вовсе (бот честно откажется, как до этой ручки).
    "ИскатьСтенуВРадиусе": 16,

    // СКОЛЬКО БЛОКОВ ПОДРЯД ДОЛЖНА БЫТЬ СПЛОШНОЙ КОЛОННА, чтобы считаться
    // стеной. Двухблочный валун — не стена: залезешь на него и снова стоишь в
    // яме, а нейросеть получит «поднялся» и решит, что дело сделано.
    "ВысотаСтеныДляПодъёма": 3,

    // НАСКОЛЬКО ВЫСОКИЙ СТОЛБ БОТ СОГЛАСЕН ПОСТРОИТЬ ЗА РАЗ, блоков. У ИИ это
    // прямой предел её собственного умения «climb_to»: попросит выше — получит
    // отказ, где названы и число, и эта ручка, и придумает другой ход.
    "МаксимальныйСтолб": 24,

    // НАСКОЛЬКО БЛИЗКО К ЦЕЛИ ПО ГОРИЗОНТАЛИ ИМЕЕТ СМЫСЛ СТРОИТЬ ВЕРТИКАЛЬ — и
    // вверх, и вниз, блоков. Дальше это уже не подъём к цели, а башня посреди
    // поля (и не спуск к цели, а колодец посреди поля).
    // ИИ ЭТО СТЕРЕЖЁТ ЧАЩЕ ВСЕХ: она называет координаты по памяти и по карте, и
    // «climb_to» с промахом в полсотни блоков без этой заставы означал бы башню
    // не там, а «descend_to» — колодец сквозь породу и бота на дне чужой ямы.
    "СтолбитьсяВРадиусе": 20,

    // МОСТИТЬ ЛИ РАЗРЫВЫ НА ПУТИ, когда перепрыгнуть нельзя. Заводское — ДА.
    // Порядок цен соблюдает сама механика: сперва ПРЫЖОК (ноль блоков), и лишь
    // потом мост; за разрывом, где вставать не на что, мост не предлагается
    // вовсе — «мост туда кончится над пустотой».
    // Снимают там, где боту нельзя оставить в чужом мире ни одного своего блока.
    "МоститьРазрывы": true,

    // ШИРЕ ЭТОГО РАЗРЫВА НЕ МОСТИТЬ, блоков. Мост вчетверо дороже прыжка, и
    // четвёрка — это «расщелина», а не «ущелье».
    "МоститьРазрывДо": 4,

    // СКОЛЬКО РАЗ ЗА ОДИН ПОХОД БРАТЬСЯ ЗА МОСТ.
    "ПопытокМоста": 2,

    // ПРЕДЕЛ САМОГО МЕХАНИЗМА СТРОЙКИ, блоков: отдельное число от порога решения
    // выше. Решает движение («стоит ли»), а строит стройка («смогу ли»), и один
    // общий предел скрыл бы, кто именно отказал, — а ИИ читает именно текст
    // отказа и по нему выбирает следующий ход.
    "ПределМостаСтройки": 8,

    // ХОДИТЬ ЛИ В ПРИСЯД ПОД НИЗКИМ ПОТОЛКОМ. Приём не стоит НИЧЕГО — ни блока не
    // сломано, ни блока не положено, — и потому в переборе выходов он ПЕРВЫЙ,
    // раньше даже «смахнуть мелочь с дороги»: зачем ломать, если был путь.
    // ЧТО ЭТО ДАЁТ ИИ: её «goto» перестаёт возвращать «дороги нет» там, где
    // живой игрок просто пригнулся бы, — а на каждый такой ложный отказ она
    // тратит ход, то есть запрос к поставщику и ваши деньги.
    // ЧЕСТНО О ГРАНИЦЕ: присед укорачивает тело с 1,85 до 1,48 — это 0,37 бл, а
    // не целый блок. Щель ровно в клетку не берётся ни стоя, ни пригнувшись.
    // Цена: под самой щелью бот идёт втрое медленнее (в игре присед это ×0,35).
    "ХодитьВПрисяде": true,

    // НАСКОЛЬКО ДЛИННЫЙ НИЗКИЙ ХОД БОТ БЕРЁТСЯ ПРОЙТИ НА КОРТОЧКАХ, клеток.
    // Четыре — это ход под мостом, под лестничным маршем, под свесом дома: то, у
    // чего видно другой конец. Дальше начинается «ползу неизвестно куда», а
    // разворачиваться в низком ходу дорого.
    "НизкийХодДлинойДо": 4,

    // ЗА СКОЛЬКО КЛЕТОК ПО КУРСУ БОТ ВООБЩЕ ЗАМЕЧАЕТ НИЗКИЙ ХОД, блоков. Приём
    // зовётся, когда дороги нет, а стоять бот при этом может и не вплотную к
    // щели: маршрут отказывает от старта, а щель в десятке шагов. Дюжина — то,
    // что живой игрок видит и понимает с места; дальше начинается не «вижу
    // проход», а «гадаю по невыгруженным чанкам».
    "ЗамечатьНизкийХодЗа": 12,

    // СПУСКАТЬСЯ ЛИ С ОБРЫВОВ, когда обойти нельзя: спрыгнуть, ступенями,
    // лестницей по стене или разбирая породу под собой. Заводское — ДА.
    // Что дешевле, решает механика; СПРЫГНУТЬ она вправе только по двум
    // разрешениям сразу — смелости роли и бюджету урона прямо сейчас, так что
    // «да» здесь не значит «прыгает с любой высоты».
    "СпускатьсяСОбрывов": true,

    // ГЛУБЖЕ ЭТОГО ОБРЫВА ВНИЗ НЕ ЛЕЗЕМ, блоков: это предел ОСМОТРА ДНА — не
    // видно дна ближе, вниз не лезем. Для ИИ это заодно и ответ на её «descend_to»
    // в неизвестность.
    "СпускатьсяСВысотыДо": 24,

    // СКОЛЬКО РАЗ ЗА ОДИН ПОХОД БРАТЬСЯ СПУСКАТЬСЯ.
    "ПопытокСпуска": 2,

    // ПРЕДЕЛ САМОГО МЕХАНИЗМА СПУСКА ЗА ОДИН ЗАХОД, блоков — пара к
    // «ПределМостаСтройки» и с той же причиной раздельности. Этим же числом
    // отвечает умение «descend_to», когда нейросеть просит слезть глубже.
    "ПределСпускаСтройки": 32,

    // СПРАШИВАТЬ ПРО ВОДУ ПЕРЕД ПРЯМЫМ ХОДОМ. Множитель платы за плавание живёт
    // в поиске пути, а прямых ходов в библиотеке два, и оба про воду не знали:
    // «!комне» через пруд бот шёл вплавь, теряя вчетверо.
    // ИИ ЭТО КАСАЕТСЯ НАПРЯМУЮ: её «goto» — как раз такой прямой ход, а цели она
    // называет по карте, не глядя, что между ними озеро. Лужу бот пройдёт
    // напрямик и с этой настройкой: считается не «есть ли вода», а во сколько
    // лишних блоков ходу она обойдётся.
    "СмотретьВодуПередПрямымХодом": true,

    // ВО СКОЛЬКО СЕКУНД ОБХОДИТСЯ ОДНА СТУПЕНЬ ЛЕСЕНКИ. По этому числу бот решает
    // ДО первого удара киркой, влезет ли лесенка в отпущенное время: «лесенку
    // вверх не начинаю: на 15 ступеней надо около 90 с, а осталось 30». Нейросеть
    // отпускает боту секунды сама (довод «seconds» у её умений), и без этого
    // счёта бот брался бы за лесенку, которую заведомо не докончит.
    "СекундНаСтупень": 6,

    // НАСКОЛЬКО ГЛУБОКУЮ ЯМУ БОТ ПРЕДПОЧИТАЕТ ВЫКОПАТЬ, А НЕ ЗАСТРОИТЬ, блоков.
    // Ниже этой глубины он рубит себе лесенку в стене — ничего не тратит и ничего
    // не оставляет в мире; выше берётся за покупные приёмы (лестница по стене,
    // столб из сумки).
    //
    // ЧЕСТНО: ЭТА СТРОКА ВПРАВДУ МЕНЯЕТ ПОВЕДЕНИЕ ИИ, И ОНА ЗДЕСЬ ОДНА ТАКАЯ.
    // Число жило в библиотеке (Tunnel.StepsOutMaxDepth) и равнялось ТРЁМ, донести
    // его до бота не умела ни одна роль. У ручки заводское — ДВЕНАДЦАТЬ, и с этой
    // волны двенадцать достаются и ИИ: из ям глубже трёх блоков бот теперь
    // выходит СТУПЕНЯМИ, а не лестницей и столбом из сумки. Так и задумано —
    // ступени ничего не тратят, — но сказать об этом надо было вслух.
    // Живой случай, ради которого двенадцать и выбраны (16.08, 12:53:10): до
    // верха семь блоков, порог три — и бот, у которого в сумке лежали лестницы и
    // три сотни дорожного полотна, полез строить. Перекладина встала ему в клетку
    // собственных ног, столб после неё не вырос, три минуты ушли в круг. Тот же
    // подъём ступенями он взял за тридцать три секунды.
    // ВЕРНУТЬ ПРЕЖНЕЕ можно, поставив 3. Ноль — ступенями не выходить вовсе (так
    // спрашивает тот, кому нельзя портить стены вокруг).
    "ВыходитьСтупенямиДо": 12,

    // СКОЛЬКО СЕКУНД ПОМНИТЬ, ЧТО ОТСЮДА ТУДА НЕ ДОЙТИ. Ноль — не помнить вовсе.
    // ЖИВОЙ СЛУЧАЙ (журнал 16.08, 20:30:06–20:32:48): подбор целился в камень на
    // дне ямы, движение честно отвечало «не дойти» — и через секунду его
    // спрашивали о том же. За две с половиной минуты 15 полных походов на ПЯТЬ
    // клеток, 363 строки журнала и 45 раз подряд одна и та же строка.
    // ИИ ЭТО СБЕРЕГАЕТ ЕЩЁ И ДЕНЬГИ: она переспрашивает охотнее любой роли —
    // получила «не дошёл», подумала, позвала «goto» снова, — и каждый такой круг
    // это запрос к поставщику. Память забывается сама, стоит боту сдвинуться с
    // места или миру перемениться по факту от сервера, поэтому число маленькое:
    // это защита от повтора одного расчёта в одну секунду, а не приговор клетке.
    "ПомнитьОтказДорогиСекунд": 20,

    // ---- опись (раздел окна «Опись склада») ----

    // ОСМАТРИВАТЬ СУНДУКИ КАЖДЫЙ РАЗ, КОГДА ПРИШЁЛ НА СКЛАД.
    "ОписыватьСкладПриРейсе": true,

    // СКОЛЬКО МИНУТ ЗАПИСЬ СЧИТАЕТСЯ СВЕЖЕЙ.
    "ОписьСвежаМинут": 5,

    // ЧЕРЕЗ СКОЛЬКО МИНУТ ОТВЕТ «ЭТОГО ТАМ НЕТ» ПЕРЕСТАЁТ БЫТЬ ОТВЕТОМ.
    "ОписьПротухаетЧерезМинут": 30,

    // СКОЛЬКО СЕКУНД ОТВОДИТСЯ НА ОБХОД СКЛАДА. Потолок нужен затем, что
    // без него опись съедала бы тот самый рейс, ради которого бот и пришёл.
    "СекундНаОбходСклада": 60,

    // ---- очередь (раздел окна «Очередь задач») ----

    // СКОЛЬКО СЕКУНД ДАВАТЬ НА ДОРОГУ К ТОЧКЕ ЗАДАЧИ. Не дошёл за это время
    // — задача честно кончается словами «до точки работы не дошёл», а не
    // стоит всю ночь.
    "СекундНаДорогуКЗадаче": 300,

    // БЕЖАТЬ ЛИ ДОМОЙ ЗА НЕДОСТАЮЩИМ МАТЕРИАЛОМ — общее решение на всю
    // очередь. Отдельная задача вправе сказать своё («домойЗаМатериалом»),
    // и её слово старше этого.
    "БегатьДомойЗаМатериалом": true,

    // СКОЛЬКО РАЗ ЗА ОДНУ ЗАДАЧУ ОТЛУЧАТЬСЯ ДОМОЙ.
    "РейсовДомойЗаЗадачу": 2,

    // НА СКОЛЬКО СБОРОВ РЕЦЕПТА БРАТЬ МАТЕРИАЛ ЗА ОДИН РЕЙС.
    "БратьМатериалНаСборов": 8,

    // ДАЛЬШЕ ЭТОГО ЗА МАТЕРИАЛОМ НЕ ХОДИТЬ, блоков. 0 — порога нет. ЗАКАЗ
    // 15.08: «порог „стоит ли идти“ (далеко ли, много ли времени) —
    // настройкой роли».
    "ЗаМатериаломНеДальшеБлоков": 0,

    // И НЕ ДОЛЬШЕ ЭТОГО — минут на дорогу туда-обратно. 0 — порога нет.
    "ЗаМатериаломНеДольшеМинут": 0,

    // ---- транслокаторы (раздел окна «Транслокаторы») ----

    // АДРЕС КАРТЫ СЕРВЕРА, с которой брать сеть транслокаторов — ТОТ ЖЕ,
    // что у окна управления («https://map.tops.vintagestory.at/»). Пусто —
    // в интернет не ходить вовсе.
    "КартаТранслокаторов": "",

    // ФАЙЛ СЕТИ РЯДОМ С БОТОМ (он же кеш скачанного). Пусто — файлом не
    // пользоваться.
    "ФайлСетиТранслокаторов": "",

    // ЧЕРЕЗ СКОЛЬКО ЧАСОВ ИДТИ ЗА КАРТОЙ ЗАНОВО. По умолчанию сутки —
    // столько же, сколько живёт сама выгрузка (WebCartographer
    // перевыгружает мир не чаще раза в день).
    "КартаУстареваетЧерезЧасов": 24,

    // НА СКОЛЬКО БЛОКОВ БОТ ГОТОВ ОТОЙТИ ОТ СЕТИ ПЕШКОМ, чтобы попасть на
    // ближайший транслокатор (и так же — с последнего до цели).
    "ОтходитьОтСетиНеДальше": 3000,

    // ВО СКОЛЬКО СЕКУНД ОБХОДИТСЯ ОДНА ПЕРЕСАДКА — от «встал на пластину»
    // до «стою на той стороне».
    "СекундНаПересадку": 10,

    // СКОЛЬКО СЕКУНД НА БЛОК ПУТИ ПО ЗЕМЛЕ.
    "СекундНаБлокПешком": 0.22,

    // КОГДА СЕТЬ ТОГО СТОИТ: сколько секунд она должна выигрывать НА КАЖДОЙ
    // ПЕРЕСАДКЕ, чтобы бот шёл через неё, а не ногами.
    "ВыигрышНаПересадкуСекунд": 15,

    // С КАКОЙ ДАЛЬНОСТИ ВООБЩЕ ИСКАТЬ ТРАНСЛОКАТОР, блоков по прямой. 0 — не
    // искать никогда, ходить только ногами. Жалоба заказчика 01.09: «мы же
    // записываем в нашу постоянную память пары тл? а то бот побежал вместо тл»
    // — до этой ручки на сеть смотрел только щелчок по карте в окне.
    "ИскатьТранслокаторОтБлоков": 300,

    // ---- добыча-с-убитых (раздел окна «Добыча: с убитых и своя») ----

    // ЗА СВОЕЙ ВЫЛОМАННОЙ ДОБЫЧЕЙ НЕ ДАЛЬШЕ, блоков. 0 — предела нет.
    "ЗаСвоейДобычейНеДальше": 16,
}
}
