    // клетку, грань и число отработанных кругов, а не смолчит. Ниже единицы
    // не опускается: нулём заходов не освободить ни одной грани.
    "ЗаходовНаГраньОбкапывая": 3,

    // КОПАТЬ ШАХМАТКОЙ — «ЧЕРЕЗ ОДНУ», РАДИ ЦЕЛЫХ БЛОКОВ ВМЕСТО ЩЕБНЯ.
    //
    // Это ПОРЯДОК, а не выбор: ни одна клетка из работы не выпадает и ни один
    // лишний блок не ломается. Сперва снимаются «жертвы» — клетки одной
    // чётности и каждый второй поперечный слой, — а у остальных к их очереди
    // не остаётся НИ ОДНОЙ твёрдой грани. Игра при шести свободных гранях
    // отдаёт РОВНО ОДИН ЦЕЛЫЙ БЛОК вместо двух-трёх кусков щебня
    // (поведение BreakIfFloating, assets/survival/blocktypes/stone/rock.json).
    //
    // Ручка стоит У САМОГО УДАРА, поэтому её видит каждый, кто снимает породу,
    // а не каждая работа по отдельности. У карьера есть ещё и своя
    // «РовнаяЯмаЦеликом», но она про ВИД ямы, а эта про порядок: выключите
    // любую из двух — шахматки в яме не будет.
    //
    // Цена — ВРЕМЯ, а не блоки: ударов столько же, но по выработке приходится
    // пройти дважды (сперва за жертвами, потом за целыми). Нужна просто яма —
    // выключайте.
    //
    // КОГО ЭТО КАСАЕТСЯ — СПИСКОМ: ЯМА КАРЬЕРА И ОКАПЫВАНИЕ ЖИЛЫ. Обе снимают
    // ОБЪЁМ, то есть тело с толщиной по всем трём осям, а целый блок бывает
    // только там: у клетки должны освободиться ВСЕ ШЕСТЬ граней, значит каждый
    // сосед обязан либо быть воздухом, либо уйти вместе с ней.
    //
    // ДОРОГА, ШТОЛЬНЯ И УКРЫТИЕ ЦЕЛЫХ БЛОКОВ НЕ ДАЮТ НИ ОДНОГО, и это не
    // недоработка. Они снимают породу СРЕЗАМИ — ряд дороги, шаг хода, одна-две
    // клетки стены, — а у среза сосед ВПЕРЁД в заход не входит и стоит
    // нетронутой породой; одной твёрдой грани хватает, чтобы блок рассыпался
    // щебнем. Числа: ход 3×3×8 = 72 клетки объёмом даёт 3 целых, он же
    // срезами, как его копают живьём, — НОЛЬ.
    //
    // Здесь стояло «хотите целые блоки с дороги или хода — ставьте им ширину
    // от 3». Это была неправда: поставивший тройку вынимал втрое больше
    // породы и не получал ни одного целого блока, а у штольни ширины нет
    // вовсе — только «ВысотаШтольни».
    "ШахматкойРадиЦельныхБлоков": true,

    // Оставлять при себе всё, у чего есть ПРОЧНОСТЬ: инструменты и оружие.
    // Так узнаётся и модовый молот, которого нет ни в одном списке масок.
    "ОставлятьВсеИнструменты": true,

    // Оставлять при себе еду.
    "ОставлятьЕду": true,

    // Класть свет в ЛЕВУЮ руку, чтобы правая осталась под инструмент.
    // Выключить — свет поедет в правую и будет уступать кирке и оружию.
    "ФонарьВЛевойРуке": true,

    // Не носить фонарь днём. За левую руку игра берёт плату: голод растёт
    // на 20% быстрее (InventoryPlayerHotbar.OffHandHungerPenalty).
    "ФонарьТолькоВТемноте": true,

    // Вернуть фонарь в сумку, когда рассвело или когда факел прогорел.
    "УбиратьФонарьДнём": true,

    // НОСИТЬ ФОНАРЬ И В ПЕЩЕРЕ, а не только ночью. Заказчик дословно:
    // «Фонарь нужно использовать ночью и в пещерах (но сделай доп
    // настройкой)».
    "ФонарьВПещере": true,

    // С КАКОЙ ГЛУБИНЫ ПОД ПОВЕРХНОСТЬЮ ЭТО УЖЕ ПЕЩЕРА, блоков.
    "ПещераГлубжеБлоков": 6,

    // ПОВЕРХНОСТЬ — ЭТО НЕ ГЛУБЖЕ СКОЛЬКИХ БЛОКОВ ПОД НЕБОМ. Пара к
    // «ПещераГлубжеБлоков»: под землю бот уходит на одной глубине, а
    // выходит обратно — на другой, поменьше.
    "ПоверхностьНеГлубжеБлоков": 3,

    // УБИРАТЬ ФОНАРЬ, КОГДА СВЕТ ПОДНЯЛСЯ ДО ЭТОГО УРОВНЯ (0…32, как в
    // самой игре).
    "ФонарьУбиратьПриСветеОт": 10,

    // ПОСЛЕ РАССВЕТА ДЕРЖАТЬ ФОНАРЬ ЕЩЁ, игровых часов (и настолько же
    // раньше брать его к ночи). Третий запас — по времени суток.
    "ДержатьФонарьПослеРассветаЧасов": 1,

    // НЕ ПЕРЕИГРЫВАТЬ РЕШЕНИЕ О ФОНАРЕ ЧАЩЕ, чем раз в столько секунд —
    // последний запас, уже не по числу, а по времени.
    "НеТрогатьФонарьСекунд": 20,

    // Выбрасывать землю и породу, когда место кончилось везде.
    "ВыбрасыватьЛишнее": true,

    // Ради еды выбрасывать даже при выключенном «ВыбрасыватьЛишнее».
    "ВыбрасыватьРадиЕды": true,

    // Что не выбрасывать никогда: куски кодов через запятую («clay,
    // flint»). Пусто — доверять мерке игры целиком.
    "НеВыбрасывать": "",

    // ---- путь (раздел окна «Путь и препятствия») ----
    //
    // РАЗДЕЛА ЭТОГО У ПРОДАВЦА НЕ БЫЛО ВОВСЕ. Двадцать три ручки про подъёмы,
    // обрывы, мосты, присед и воду на дороге жили у одного Выживальщика — а
    // ходит продавец каждый день: обход прилавков, рейс на склад, дорога домой
    // ночью. Спотыкается он о те же кочки, что и копатель. Четыре из них
    // приходилось заводить ТРИЖДЫ — у копателя, у стражника, у продавца, — и три
    // объяснения одной ручки уже начали расходиться. Теперь ручка одна, а разные
    // ответы ролей остались разными: четыре ниже у продавца стоят «нет», и
    // почему — сказано у каждой.
    //
    // ОДНО ПРАВИЛО НА ВЕСЬ РАЗДЕЛ, И ОНО ОБЪЯСНЯЕТ ВСЕ ЧЕТЫРЕ «НЕТ»: ПРОДАВЕЦ
    // РАБОТАЕТ В ЧУЖОЙ ЛАВКЕ. Всё, что ломает или кладёт блоки, он не делает —
    // дыра в чужом складе стоит дороже любой сэкономленной минуты. Всё, что
    // ничего не трогает, ему разрешено.
    //
    // ЧЕТЫРЕ «НЕТ» ГАСЯТ ЗА СОБОЙ ЕЩЁ ДЕСЯТЬ ЧИСЕЛ, И ЭТО НАЗВАНО ВСЛУХ У
    // КАЖДОГО. Числа не мусор: это ровно то, что вы повернёте, если лавка ваша
    // собственная и запертым в подвале оставаться нельзя. Но пока верхняя
    // галочка «нет», нижнее число не делает НИЧЕГО, и выдумывать ему пользу мы
