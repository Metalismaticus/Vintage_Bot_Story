    "ДомИСкладБерегуВРадиусе": 6,

    // ЧЕТЫРЕ РУЧКИ ЧУЖИХ ВЛАДЕНИЙ, ПРИЕХАВШИЕ 09.09. Их здесь НЕ БЫЛО ВОВСЕ —
    // жили у копателя, — а механизм работал и у стражника: границы приватов
    // сервер шлёт каждому клиенту сам (пакет 75), и бот их обходил по
