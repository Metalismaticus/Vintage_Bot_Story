    "ОтступатьНижеЗдоровья": 0.5,

    // ДО КАКОЙ ДОЛИ ЗДОРОВЬЯ ОТЛЕЖАТЬСЯ, чтобы снова принимать бой.
    "ВозвращатьсяВБойПри": 0.8,

    // ДОЛЬШЕ СКОЛЬКИХ СЕКУНД БЛОК МЕЛОЧЬЮ УЖЕ НЕ СЧИТАЕТСЯ.
    "МелочьЛомаетсяНеДольшеСек": 1,

    // КОГДА НОСИТЬ БРОНЮ — И, ТЕМ САМЫМ, КОГДА ЕЁ СНИМАТЬ. Выбор: Никогда,
    // ВБою, ПокаРядомОпасно, Всегда.
    "НоситьБроню": "ПокаРядомОпасно",

    // НИЖЕ КАКОЙ ДОЛИ СЫТОСТИ БРОСАТЬ ПОГОНЮ И ИДТИ ЕСТЬ: 0,25 — четверть.
    // Гнаться за обидчиком, когда сам умираешь, — плохая идея.
    "БроситьПогонюПриСытостиНиже": 0.25,

    // НА СКОЛЬКО БЛОКОВ СЧИТАТЬ, ЧТО ОТОРВАЛСЯ.
    "ОтрыватьсяНеБлижеЧемНа": 6,

    // БЛИЖЕ СКОЛЬКИХ БЛОКОВ ВРАГ — ПОВОД БРОСАТЬ ДЕЛО И БЕЖАТЬ. Приехала
    // 08.09; половина этой семьи (цена ухода 16, цена закладывания 12, порог
