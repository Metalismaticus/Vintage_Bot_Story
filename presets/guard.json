    // но ждёт ЗДЕСЬ, чтобы включивший «ИзбегатьИгроков» увидел цену рядом
    "ПомнитьИгроковМинут": 5,

    // СЧИТАТЬ ЧУЖИМ МЕСТОМ И ТО, ГДЕ БОТ ВИДЕЛ ЖИВОГО ИГРОКА. ДЛЯ СТРАЖНИКА —
    // ТВЁРДОЕ «НЕТ», и вот живая причина, а не осторожность вообще.
    //
    // Место человека помнится КОРОТКОЙ меркой примет (32 блока), а не
