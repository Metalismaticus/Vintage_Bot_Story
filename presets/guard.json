    "Мстить": "Никогда",
    "ЦенаУхода": 16,

    // СПАТЬ НЕ ХОДИТ: пост есть пост, и кровати у ворот обычно нет
    "СпатьНочью": false,

    // ЛЮДИ. Здороваться сторожу положено по службе
    "Здороваться": true,
    "МахатьИгрокам": true,
    "МахатьРазВМинут": 15,
    "РадиусПриветствия": 12,

    // ЧЕМ И КАКИМИ СЛОВАМИ ЗДОРОВАТЬСЯ — ПЯТЬ РУЧЕК, ПРИЕХАВШИХ 08.09. Три
    // строки выше («махать», «как часто», «за сколько блоков») были у
    // стражника и раньше, а вот ЧЕМ он машет и ЧТО говорит, решала библиотека:
    // ручки жили у копателя. Числа и слова здесь заводские — те самые, на
    // которых стражник и здоровался; новое тут одно: их стало видно.
    //
    // Чем махнуть. Игра знает wave, cheer, shrug, cry, nod, facepalm, bow,
    // laugh, rage. СТОРОЖУ ЭТО НЕ УКРАШЕНИЕ: взмах у ворот — первое, по чему
