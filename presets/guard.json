    // СТОРОЖ НЕ ОХОТИТСЯ: уход за зверем — это брошенный пост, а заход охоты
    // держит тело рефлексом и на эти секунды запирает саму стражу. Готовить
    // и брать еду со склада он при этом умеет — обе двери в шаге от поста
    "ЕдаИзКладовых": true,
    "ГотовитьЕду": true,
    "СколькоЖдатьГотовки": 30,
    "Охотиться": false,
    "ОхотитьсяНеДальше": 12,
    "СколькоДержатьТелоЗаОхоту": 15,

    "ПодбиратьДобычуСУбитых": true,
    "ЗаДобычейСУбитыхНеДальше": 12,
    "УходитьПриНизкойСтабильности": true,

    // НЕ СТОЯТЬ ТАМ, ГДЕ ЖГУТ. Заказчик дословно: «на костре не стоять и на
