    "ДомойЗаКроватью": true,

    // ---- безопасность (раздел окна «Безопасность») ----

    // Ломать ли посевы на ВСПАХАННОЙ земле.
    "ТрогатьЧужиеГрядки": false,

    // НАСКОЛЬКО МОЖНО ОТОЙТИ ОТ МЕСТА, ГДЕ СПРЯТАЛСЯ, и всё ещё считаться
    // спрятавшимся, блоков. Укрытие бот держит двумя приёмами, и второй —
    // своя закрытая дверь.
    "УкрытиеДержитсяВРадиусе": 6,

    // НАСКОЛЬКО РЕЖЕ ПОВТОРЯТЬ ОДНУ И ТУ ЖЕ НОВОСТЬ ПРО РАЗЛОМЫ, секунд. 0
    // — не глушить вовсе (на разбор живого журнала).
    "ПовторыПроРазломыРежеСекунд": 300,

    // НАСКОЛЬКО РЕЖЕ ПОВТОРЯТЬ ОДНУ И ТУ ЖЕ НОВОСТЬ ПРО ЗДОРОВЬЕ, секунд. 0
    // — печатать каждую строку сервера (на разбор живого журнала).
    "ПовторыПроЗдоровьеРежеСекунд": 60,

    // ЧЕРЕЗ СКОЛЬКО МИНУТ СНОВА ПРОБОВАТЬ КОСТЁР, если дров, растопки или
    // огнива не нашлось. 0 — пробовать каждый раз (на разбор живого
    // журнала).
    "ПробоватьКостёрСноваЧерезМин": 10,

    // ДОЛЬШЕ СКОЛЬКИХ СЕКУНД НЕ МОЛЧАТЬ. 0 — молчать сколько угодно
    // (поведение до этой правки).
    "МолчатьНеДольшеСек": 60,

    // ДО СКОЛЬКИХ ГРАДУСОВ ГРЕТЬСЯ, РАЗ УЖ ВСТАЛ К ОГНЮ.
    // ЧИСЛО ВЫГЛЯДИТ СТРАННО, И ЭТО НАРОЧНО. Ручка объявлена double, а
    // заводское берётся у float-постоянной игры (BodyHeat.HottestShownTemperature
