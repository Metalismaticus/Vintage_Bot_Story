    // пользу здесь было бы враньём; она стоит в файле затем, чтобы включивший
    // рейс увидел цену неудачи рядом, а не искал её в окне у другой роли
    "ПовторРазгрузкиЧерезСекунд": 60,

    // ---------------- ОБЩЕЕ (вкладка «Общие настройки») ----------------

    // Ставить точку возрождения дома. Тратит временную шестерёнку
    "ОтмечатьДом": true,

    // ЦЕНА ДОРОГИ ЗА ТОЧКОЙ ВОЗРОЖДЕНИЯ — ДВЕ РУЧКИ, ПРИЕХАВШИЕ 08.09.
    // Галочка выше у стражника ВКЛЮЧЕНА, а сказать, куда он за этим пойдёт,
    // было нечем: обе ручки жили у копателя, и механизм ходил на библиотечных
