    // ходил и вчера; строка меняет не поведение, а то, что человек об этом
    // ЗНАЕТ.
    //
    // Дальше этого ради отметки не идти, блоков. ДЛЯ СТРАЖНИКА ЭТО ЦЕНА
    // ПУСТЫХ ВОРОТ: пятьсот блоков — полкарты, и всю дорогу туда и обратно
    // пост стоит без него. Ставьте столько, сколько ворота согласны его не
    // видеть; ноль — «за точкой не ходить вовсе, только отмечать, когда и так
    // дома»
    "ДомДальше": 500,

    // С какого расстояния точка считается домашней, блоков. Сервер ставит её
    // в позицию ИГРОКА, а не ровно в заданную клетку. Стражнику этот допуск
    // нужнее прочих: он стоит НЕ ВПЛОТНУЮ к дому, а у ворот, и без допуска
    // переставлял бы точку временной шестерёнкой каждую минуту — то есть
    // проедал бы редкую вещь, стоя на месте
    "ДопускДома": 4,

