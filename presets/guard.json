    // называл ручку «ДобыватьМатериалНаСтолб», которой не существовало.
    "ДобыватьМатериалНаСтолб": false,

    // НА СКОЛЬКО БЛОКОВ ВОКРУГ ИСКАТЬ СТЕНУ, к которой идти со дна широкой ямы:
    // столб посреди карьера выводит на верх палки 1×1, откуда не слезть, — потому
    // сперва к стене.
    // У СТРАЖНИКА ЧИСЛО ПОГАШЕНО НАСМЕРТЬ, и это видно в самой проводке: радиус
    // поиска стены берётся НУЛЁМ, пока «ВыбиратьсяНаверх» стоит «нет».
    "ИскатьСтенуВРадиусе": 16,

    // СКОЛЬКО БЛОКОВ ПОДРЯД ДОЛЖНА БЫТЬ СПЛОШНОЙ КОЛОННА, чтобы считаться
    // стеной. Двухблочный валун — не стена: залезешь на него и снова стоишь в
    // яме. Пара к строке выше и молчит вместе с ней.
    "ВысотаСтеныДляПодъёма": 3,

    // НАСКОЛЬКО ВЫСОКИЙ СТОЛБ БОТ СОГЛАСЕН ПОСТРОИТЬ ЗА РАЗ, блоков.
    // ЧЕСТНО: В ЭТОМ ПРЕСЕТЕ ПОВОРАЧИВАТЬ ЗДЕСЬ НЕЧЕГО, и придумывать пользу мы
    // не будем. Число спрашивают ровно два хода — команды «!заберись» и «!слезь»,
    // — а это команды разбора, и у стражника они выключены: строки «diag» в этом
    // файле нет (в отличие от пресетов продавца и ИИ). Запустите стражника с
    // ключом --diag — число оживёт; иначе оно лежит и ждёт.
    "МаксимальныйСтолб": 24,

    // НАСКОЛЬКО БЛИЗКО К ЦЕЛИ ПО ГОРИЗОНТАЛИ ИМЕЕТ СМЫСЛ СТРОИТЬ ВЕРТИКАЛЬ — и
    // вверх, и вниз, блоков. Дальше это уже не подъём к цели, а башня посреди
    // поля (и не спуск к цели, а колодец посреди поля). Спрашивается там же, где
    // строка выше, и у стражника без --diag так же молчит.
    "СтолбитьсяВРадиусе": 20,

    // МОСТИТЬ ЛИ РАЗРЫВЫ НА ПУТИ, когда перепрыгнуть нельзя. Заводское у
    // стражника — НЕТ: мост через ров перед воротами — дыра в обороне, которую
    // стражник построил бы сам себе. Той же бедой заведена: в коде стоял гвоздь,
    // а отказ звал «MaxBridgeSpan» — английское имя поля библиотеки, которого в
    // окне нет вовсе.
    // ПРЫГАТЬ ОН ПРИ ЭТОМ НЕ РАЗУЧИЛСЯ: прыжок стоит ноль блоков и решается не
    // этой ручкой, а смелостью и бюджетом урона.
    "МоститьРазрывы": false,

    // ШИРЕ ЭТОГО РАЗРЫВА НЕ МОСТИТЬ, блоков. Спит вместе со строкой выше.
    "МоститьРазрывДо": 4,

    // СКОЛЬКО РАЗ ЗА ОДИН ПОХОД БРАТЬСЯ ЗА МОСТ. Спит там же.
    "ПопытокМоста": 2,

    // ПРЕДЕЛ САМОГО МЕХАНИЗМА СТРОЙКИ, блоков: отдельное число от порога решения
    // выше. Решает движение («стоит ли»), а строит стройка («смогу ли»), и один
    // общий предел скрыл бы, кто именно отказал. Пока мост выключен, спросить
    // это некому.
    "ПределМостаСтройки": 8,

    // ХОДИТЬ ЛИ В ПРИСЯД ПОД НИЗКИМ ПОТОЛКОМ — И ЭТО ПЕРВЫЙ ИЗ ТРЁХ ПРИЁМОВ
    // ПУТИ, КОТОРЫЕ У СТРАЖНИКА ВПРАВДУ РАБОТАЮТ. Он не стоит НИЧЕГО: ни блока
    // не сломано, ни блока не положено, — то есть не делает в чужой стене той
    // дыры, ради которой выключены подъём, мост и спуск. Потому в переборе
    // выходов он и стоит первым, раньше даже «смахнуть мелочь с дороги».
    // ЧТО ЭТО ДАЁТ СТРАЖНИКУ: дорогу на пост под воротной аркой, под лестничным
    // маршем на стену и под свесом надвратной площадки — вместо «к посту дороги
    // нет» бот пригибается и идёт.
    // ЧЕСТНО О ГРАНИЦЕ: присед укорачивает тело с 1,85 до 1,48 — это 0,37 бл, а
    // не целый блок. Щель ровно в клетку не берётся ни стоя, ни пригнувшись.
    // Цена: под самой щелью бот идёт втрое медленнее (в игре присед это ×0,35).
    "ХодитьВПрисяде": true,

    // НАСКОЛЬКО ДЛИННЫЙ НИЗКИЙ ХОД БОТ БЕРЁТСЯ ПРОЙТИ НА КОРТОЧКАХ, клеток.
    // Четыре — это ход под мостом, под лестничным маршем, под свесом: то, у чего
    // видно другой конец. Дальше начинается «ползу неизвестно куда», а
    // разворачиваться в низком ходу дорого — стражнику вдвойне, пост пустует.
    "НизкийХодДлинойДо": 4,

    // ЗА СКОЛЬКО КЛЕТОК ПО КУРСУ БОТ ВООБЩЕ ЗАМЕЧАЕТ НИЗКИЙ ХОД, блоков. Приём
    // зовётся, когда дороги нет, а стоять бот при этом может и не вплотную к
    // щели: маршрут отказывает от старта, а щель в десятке шагов. Дюжина — то,
    // что живой игрок видит и понимает с места; дальше начинается не «вижу
    // проход», а «гадаю по невыгруженным чанкам».
    "ЗамечатьНизкийХодЗа": 12,

    // СПУСКАТЬСЯ ЛИ С ОБРЫВОВ, когда обойти нельзя: спрыгнуть, ступенями,
    // лестницей по стене или разбирая породу под собой. Заводское у стражника —
    // НЕТ: спрыгнув с надвратной площадки, он обратно не поднимется (выход
    // наверх у него тоже выключен), и пост остаётся пустым. Отказ звал
    // «Movement.DescendCliffs» — имя поля библиотеки, а не настройки.
    "СпускатьсяСОбрывов": false,

    // ГЛУБЖЕ ЭТОГО ОБРЫВА ВНИЗ НЕ ЛЕЗЕМ, блоков: это предел осмотра дна — не
    // видно дна ближе, значит вниз не лезем. Спит вместе со строкой выше.
    "СпускатьсяСВысотыДо": 24,

    // СКОЛЬКО РАЗ ЗА ОДИН ПОХОД БРАТЬСЯ СПУСКАТЬСЯ. Спит там же.
    "ПопытокСпуска": 2,

    // ПРЕДЕЛ САМОГО МЕХАНИЗМА СПУСКА ЗА ОДИН ЗАХОД, блоков — пара к
    // «ПределМостаСтройки» и с той же причиной раздельности: решает движение,
    // а строит стройка. Спит там же.
    "ПределСпускаСтройки": 32,

    // СПРАШИВАТЬ ПРО ВОДУ ПЕРЕД ПРЯМЫМ ХОДОМ — ВТОРОЙ ИЗ ТРЁХ РАБОТАЮЩИХ.
    // Множитель платы за плавание живёт в поиске пути, а прямых ходов в
    // библиотеке два, и оба про воду не знали: «!комне» через пруд бот шёл
    // вплавь, теряя вчетверо.
    // СТРАЖНИКУ ЭТО ПРО РОВ. Возврат на пост и рывок домой в бурю идут тем самым
    // прямым ходом, а ров перед воротами — ровно тот случай, ради которого ручка
    // заведена: плыть в броне через свой же ров дороже, чем обойти по мосту.
    // Лужу бот пройдёт напрямик и с ней: считается не «есть ли вода», а во
    // сколько лишних блоков ходу она обойдётся.
    "СмотретьВодуПередПрямымХодом": true,

    // ВО СКОЛЬКО СЕКУНД ОБХОДИТСЯ ОДНА СТУПЕНЬ ЛЕСЕНКИ. По этому числу бот
    // решает ДО первого удара киркой, влезет ли лесенка в отпущенное время:
    // «лесенку вверх не начинаю: на 15 ступеней надо около 90 с, а осталось 30».
    // У СТРАЖНИКА СПИТ: лесенку рубит тот же выход наверх, а он «нет».
    "СекундНаСтупень": 6,

    // НАСКОЛЬКО ГЛУБОКУЮ ЯМУ БОТ ПРЕДПОЧИТАЕТ ВЫКОПАТЬ, А НЕ ЗАСТРОИТЬ, блоков.
    // Ниже этой глубины он рубит себе лесенку в стене — ничего не тратит и
    // ничего не оставляет в мире; выше берётся за покупные приёмы (лестница по
    // стене, столб из сумки).
    // У СТРАЖНИКА СПИТ ПО ТОЙ ЖЕ ПРИЧИНЕ, что и строка выше: ступени включаются
    // вместе с «ВыбиратьсяНаверх».
    "ВыходитьСтупенямиДо": 12,

    // СКОЛЬКО СЕКУНД ПОМНИТЬ, ЧТО ОТСЮДА ТУДА НЕ ДОЙТИ, — ТРЕТИЙ ИЗ ТРЁХ
    // РАБОТАЮЩИХ, И СТРАЖНИКУ ОН НУЖНЕЕ ВСЕХ. Удержание точки спрашивает дорогу
    // к посту снова и снова, заход за заходом («ЗаходовНаПост», «ПередышкаМежду
    // ЗаходамиСекунд» выше), и без памяти отказа это ровно тот круг из живого
    // журнала 16.08: за две с половиной минуты 15 полных походов на пять клеток,
    // 363 строки и 45 раз подряд одна и та же «эту клетку отсюда я уже не смог
    // достать».
    // Память забывается сама, стоит боту сдвинуться с места или миру
    // перемениться по факту от сервера, поэтому число маленькое: это защита от
    // повтора одного расчёта в одну секунду, а не приговор клетке. Ноль — не
    // помнить вовсе.
    "ПомнитьОтказДорогиСекунд": 20,

    // ---- опись (раздел окна «Опись склада») ----

    // ОСМАТРИВАТЬ СУНДУКИ КАЖДЫЙ РАЗ, КОГДА ПРИШЁЛ НА СКЛАД.
    "ОписыватьСкладПриРейсе": true,

    // СКОЛЬКО МИНУТ ЗАПИСЬ СЧИТАЕТСЯ СВЕЖЕЙ.
    "ОписьСвежаМинут": 5,

    // ЧЕРЕЗ СКОЛЬКО МИНУТ ОТВЕТ «ЭТОГО ТАМ НЕТ» ПЕРЕСТАЁТ БЫТЬ ОТВЕТОМ.
    "ОписьПротухаетЧерезМинут": 30,

    // СКОЛЬКО СЕКУНД ОТВОДИТСЯ НА ОБХОД СКЛАДА. Потолок нужен затем, что
    // без него опись съедала бы тот самый рейс, ради которого бот и пришёл.
    "СекундНаОбходСклада": 60,

    // ---- очередь (раздел окна «Очередь задач») ----

    // СКОЛЬКО СЕКУНД ДАВАТЬ НА ДОРОГУ К ТОЧКЕ ЗАДАЧИ. Не дошёл за это время
    // — задача честно кончается словами «до точки работы не дошёл», а не
    // стоит всю ночь.
    "СекундНаДорогуКЗадаче": 300,

    // БЕЖАТЬ ЛИ ДОМОЙ ЗА НЕДОСТАЮЩИМ МАТЕРИАЛОМ — общее решение на всю
    // очередь. Отдельная задача вправе сказать своё («домойЗаМатериалом»),
    // и её слово старше этого.
    "БегатьДомойЗаМатериалом": true,

    // СКОЛЬКО РАЗ ЗА ОДНУ ЗАДАЧУ ОТЛУЧАТЬСЯ ДОМОЙ.
    "РейсовДомойЗаЗадачу": 2,

    // НА СКОЛЬКО СБОРОВ РЕЦЕПТА БРАТЬ МАТЕРИАЛ ЗА ОДИН РЕЙС.
    "БратьМатериалНаСборов": 8,

    // ДАЛЬШЕ ЭТОГО ЗА МАТЕРИАЛОМ НЕ ХОДИТЬ, блоков. 0 — порога нет. ЗАКАЗ
    // 15.08: «порог „стоит ли идти“ (далеко ли, много ли времени) —
    // настройкой роли».
    "ЗаМатериаломНеДальшеБлоков": 0,

    // И НЕ ДОЛЬШЕ ЭТОГО — минут на дорогу туда-обратно. 0 — порога нет.
    "ЗаМатериаломНеДольшеМинут": 0,

    // ---- транслокаторы (раздел окна «Транслокаторы») ----

    // АДРЕС КАРТЫ СЕРВЕРА, с которой брать сеть транслокаторов — ТОТ ЖЕ,
    // что у окна управления («https://map.tops.vintagestory.at/»). Пусто —
    // в интернет не ходить вовсе.
    "КартаТранслокаторов": "",

    // ФАЙЛ СЕТИ РЯДОМ С БОТОМ (он же кеш скачанного). Пусто — файлом не
    // пользоваться.
    "ФайлСетиТранслокаторов": "",

    // ЧЕРЕЗ СКОЛЬКО ЧАСОВ ИДТИ ЗА КАРТОЙ ЗАНОВО. По умолчанию сутки —
    // столько же, сколько живёт сама выгрузка (WebCartographer
    // перевыгружает мир не чаще раза в день).
    "КартаУстареваетЧерезЧасов": 24,

    // НА СКОЛЬКО БЛОКОВ БОТ ГОТОВ ОТОЙТИ ОТ СЕТИ ПЕШКОМ, чтобы попасть на
    // ближайший транслокатор (и так же — с последнего до цели).
    "ОтходитьОтСетиНеДальше": 3000,

    // ВО СКОЛЬКО СЕКУНД ОБХОДИТСЯ ОДНА ПЕРЕСАДКА — от «встал на пластину»
    // до «стою на той стороне».
    "СекундНаПересадку": 10,

    // СКОЛЬКО СЕКУНД НА БЛОК ПУТИ ПО ЗЕМЛЕ.
    "СекундНаБлокПешком": 0.22,

    // КОГДА СЕТЬ ТОГО СТОИТ: сколько секунд она должна выигрывать НА КАЖДОЙ
    // ПЕРЕСАДКЕ, чтобы бот шёл через неё, а не ногами.
    "ВыигрышНаПересадкуСекунд": 15,

    // С КАКОЙ ДАЛЬНОСТИ ВООБЩЕ ИСКАТЬ ТРАНСЛОКАТОР, блоков по прямой. 0 — не
    // искать никогда, ходить только ногами. Жалоба заказчика 01.09: «мы же
    // записываем в нашу постоянную память пары тл? а то бот побежал вместо тл»
    // — до этой ручки на сеть смотрел только щелчок по карте в окне.
    "ИскатьТранслокаторОтБлоков": 300,

    // ---- добыча-с-убитых (раздел окна «Добыча: с убитых и своя») ----

    // РАЗДЕЛЫВАТЬ ТУШИ НОЖОМ и забирать из них добычу. Та самая «отдельная
    // настройка», о которой просил заказчик, — и отдельная она не для
    // красоты: это ДРУГОЙ механизм игры.
    "РазделыватьТуши": true,

    // РАЗДЕЛКА ПЕРЕБИВАЕТ РАБОТУ. У стражника «работа» — это пост, и он
    // никуда не денется: пост меряется расстоянием, а не часами, и бот
    // вернётся на него сам. Туша так не умеет — три игровых часа, и она
    // пропала вместе с добычей. Бой, побег, еда и лечение выше разделки
    // при любом положении галочки, так что пост не останется без защиты
    "РазделкаПеребиваетРаботу": true,
}
}
