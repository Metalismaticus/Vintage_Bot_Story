@echo off
title Vintage Bot Story — обычный житель
rem Стандартный бот: живёт, слушается команд в чате, сам никуда не бежит.
rem Подключается к 127.0.0.1:42420. Всё, что напечатаете здесь после входа,
rem уйдёт в игровой чат. quit — выход.
rem
rem --diag добавляет команды проверки: !часы !предмет !сколько !копай
rem        !припасы !костёр !еда !собери !вспаши !путь !обрыв и другие
chcp 65001 >nul
dotnet run --project "%~dp0VintageBotStory" -- --diag
pause
