# БОТ В КОНТЕЙНЕРЕ — для арендованного сервера, где есть только ssh.
#
# ЧЕГО ЗДЕСЬ НЕТ И НЕ БУДЕТ: файлов игры. Vintage Story платная, и класть её в
# образ нельзя — ни по совести, ни по лицензии. Игра ПОДКЛЮЧАЕТСЯ томом, а бот
# берёт из неё сборки и библиотеку сжатия (см. VsBotKit/GameNatives.cs).
#
# СОБРАТЬ (сперва бинарник, потом образ — сборка внутри контейнера невозможна
# ровно потому же: там нет игры, а без её .dll бот не компилируется):
#     ./publish.sh linux-x64
#     docker build -t vsbot .
#
# ЗАПУСТИТЬ:
#     docker run --rm -it --network host \
#         -v /srv/vintagestory:/game:ro \
#         -v /srv/vsbot-data:/data \
#         -e VS_PANEL_PASSWORD='пароль-от-окна' \
#         vsbot
#
# ПРО --network host — ЭТО НЕ ПРИХОТЬ. Окно управления слушает только петлю
# (127.0.0.1) и это закон проекта, а не настройка. Из контейнера со своей сетью
# «петля» — это петля КОНТЕЙНЕРА, и обычная публикация порта (-p 42462:42462)
# до неё не достанет. Поэтому либо --network host (только Linux), либо
# докера здесь вообще не нужно: один самодостаточный файл и ssh -L делают то
# же самое и проще.
#
# СМОТРЕТЬ ОКНО: с домашней машины
#     ssh -L 42462:127.0.0.1:42462 пользователь@сервер
# и открыть http://127.0.0.1:42462/ у себя.
#
# ЧЕГО МЫ НЕ ПРОВЕРИЛИ, И ЭТО ВАЖНО ЗНАТЬ ДО ТОГО, КАК ПОВЕРИТЬ ЭТОМУ ФАЙЛУ.
# `docker build` по нему НЕ ЗАПУСКАЛСЯ: на машине, где он писался, движок
# Docker так и не поднялся. Проверено только то, что образ
# mcr.microsoft.com/dotnet/runtime-deps:10.0 существует и собран на Ubuntu
# (значит, apt и пакет libzstd1 — те самые). Всё остальное здесь — рассуждение
# по разобранным фактам, а не работающая сборка. Считайте это заготовкой,
# которую надо один раз собрать и поправить, а не готовым решением.

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0

# libzstd1 — та самая библиотека сжатия. На Linux игровой резолвер пробует
# СИСТЕМНУЮ libzstd.so.1 ПЕРВОЙ (разобрано по IL: ZstdNative.DllImportResolver),
# поэтому пакета достаточно, даже если папка с игрой смонтирована только для
# чтения и своей копии сделать некуда.
# ca-certificates — вход под аккаунтом идёт по https к auth3.vintagestory.at.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libzstd1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Где искать игру. Том сюда монтируется при запуске; без него бот честно
# откажется стартовать и скажет, что именно не нашёл.
ENV VINTAGE_STORY=/game

# Куда бот пишет своё хозяйство: настройки, журналы, ключ сессии, очередь
# задач. Отдельным томом — чтобы пересборка образа не стирала bot.json и
# botsession.json.
#
# ПОЧЕМУ ИМЕННО VSBOT_STATE, А НЕ XDG_STATE_HOME. Здесь раньше стояла
# XDG_STATE_HOME, и она НЕ РАБОТАЛА: BotFolders.State() сперва пробует папку
# рядом с ботом, а в контейнере /app записываем (запуск под root), — значит
# всё ложилось в слой образа, мимо тома, и пересборка это стирала. XDG-путь
# бот смотрит только тогда, когда рядом с собой писать НЕЛЬЗЯ. VSBOT_STATE —
# это «держи состояние здесь», и её слушают первой, до всех проверок.
ENV VSBOT_STATE=/data
VOLUME ["/data"]

# ПРЕСЕТЫ ОСТАЮТСЯ В /app, И ТАК И НАДО. Готовые боты едут ВМЕСТЕ С
# ПРОГРАММОЙ (publish.sh кладёт папку presets рядом с ботом), а не с
# состоянием: положи мы их в /data — подключённый том закрыл бы их собой, и в
# окне управления не оказалось бы ни одного готового бота. PresetLibrary
# смотрит обе папки: свои пресеты пишет в состояние, готовые читает рядом с
# программой.
WORKDIR /app
COPY out/linux-x64/ /app/
RUN chmod +x /app/VintageBotStory

# Бот НЕ входит на сервер сам: он поднимается и ждёт нажатия «Вход» в окне
# управления. Запуск без единого аргумента — это и есть режим окна.
ENTRYPOINT ["/app/VintageBotStory"]
