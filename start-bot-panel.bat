@echo off
title Vintage Bot Story — копатель с окном управления
rem Копатель с окном настроек в браузере.
rem
rem Окно откроется само: http://127.0.0.1:42462/?k=<ключ>
rem Ключ рождается заново при каждом запуске и печатается здесь же.
rem Дверь только на этой машине; на сервере смотреть через
rem   ssh -L 42462:127.0.0.1:42462 пользователь@сервер
rem
rem В окне: состояние, дела (навыки, команды, умения), настройки роли,
rem готовые боты и живой журнал.
chcp 65001 >nul
rem КЛЮЧЕЙ ТУТ БОЛЬШЕ НЕТ, И ЭТО ВАЖНО. Пока в строке стояло «--preset digger»,
rem выбор бота в окне управления НЕ МОГ ПОДЕЙСТВОВАТЬ НИКОГДА: строка запуска
rem сильнее файла настроек. Живой случай 23.08: заказчик выбрал стражника,
rem окно записало «preset: guard» в bot.json — и каждый запуск поднимал копателя.
rem Окно управления и диагностика тоже помнятся в bot.json (panel.use, diag),
rem поэтому и они отсюда убраны. Нужен разовый запуск другим ботом — допишите
rem ключ руками, он перебьёт файл на этот раз.
dotnet run --project "%~dp0VintageBotStory"
pause
